module

public import PolishSpaceBook.LambdaSyntaxSubstitution

@[expose] public section

/-! # Alpha-equivalence generated by named binder renaming

The relation and its structural invariants are proved on named terms, without
using a locally nameless representation. The representation equivalence used
by the later decision procedure is proved in `LambdaAlphaEncoding`.
-/
namespace PolishSpaceBook.NamedLambda.Term

/-- The equivalence generated by fresh binder renamings and term contexts. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: prose
  excerpt: |
    Define \termdefine{alpha-equivalence}, written $\AlphaEquivalent{M}{N}$, as the least equivalence relation preserved by application and abstraction and containing the fresh binder renamings
    $$\AlphaEquivalent{\lambdaab{x}{M}}{\lambdaab{z}{(\SubstLambda{M}{x}{z})}},
    \qquad z\notin\FreeVarsLambda{M}.$$
    Thus a bound variable may be renamed inside any subterm, provided substitution avoids capture. Alpha-equivalence records a finite sequence of such changes, used in either direction.
-/
inductive RenameEq : Term → Term → Prop where
  | refl (M : Term) : RenameEq M M
  | symm {M N : Term} : RenameEq M N → RenameEq N M
  | trans {M N P : Term} : RenameEq M N → RenameEq N P → RenameEq M P
  | app {M M' N N' : Term} : RenameEq M M' → RenameEq N N' → RenameEq (app M N) (app M' N')
  | lam (x : ℕ) {M N : Term} : RenameEq M N → RenameEq (lam x M) (lam x N)
  | rename (M : Term) (x z : ℕ) : z ∉ M.fv → RenameEq (lam x M) (lam z (M.subst x (var z)))


/-- Renaming bound variables does not change term size. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: proposition
  title: Invariants of binder renaming
-/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    \begin{proof}[Proof]
    Induct on the derivation of alpha-equivalence. Reflexivity, symmetry and transitivity preserve each assertion. The application and abstraction cases follow from the corresponding assertions for their immediate subterms. For one generating renaming, the free-variable formula for substitution and the freshness of $z$ give the same free variables after abstraction. Substitution of a variable for a variable preserves node count. It also preserves the outer constructor of every subterm, even when it must rename an inner binder to avoid capture. This follows by induction on the substitution budget: the renaming branch makes two variable-for-variable calls on smaller budgets. Hence an application has an abstraction as its operator before the renaming exactly when it does afterwards. This proves preservation of redex-freeness and completes the induction.
    \end{proof}
-/
theorem RenameEq.nodes_eq {M N : Term} (h : RenameEq M N) : M.nodes = N.nodes := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | app _ _ ih₁ ih₂ => simp only [nodes, ih₁, ih₂]
  | lam x _ ih => simp only [nodes, ih]
  | rename M x z hz => simp only [nodes, nodes_subst_var]

/-- Free-variable sets are invariant under the generating renamings. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: proposition
  title: Invariants of binder renaming
-/
theorem RenameEq.fv_eq {M N : Term} (h : RenameEq M N) : M.fv = N.fv := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | app _ _ ih₁ ih₂ => simp only [fv, ih₁, ih₂]
  | lam x _ ih => simp only [fv, ih]
  | rename M x z hz =>
    ext v
    simp only [fv, Finset.mem_erase, mem_fv_subst, Finset.mem_singleton]
    by_cases hvz : v = z
    · subst v; simp [hz]
    · tauto

/-- Substitution for an absent variable can only rename binders. -/
theorem renameEq_subst_not_free (M N : Term) (x : ℕ) (hx : x ∉ M.fv) :
    RenameEq (M.subst x N) M := by
  have bounded : ∀ k (M : Term), M.nodes ≤ k → x ∉ M.fv → RenameEq (M.subst x N) M := by
    intro k
    induction k with
    | zero => intro M hk; have := M.nodes_pos; omega
    | succ k ih =>
      intro M hk hx
      cases M with
      | var v =>
        have hv : v ≠ x := by simpa [fv, eq_comm] using hx
        rw [subst_var, ite_eq_right hv]
        exact .refl _
      | app M P =>
        have hm : M.nodes ≤ k := by simp only [nodes] at hk; omega
        have hp : P.nodes ≤ k := by simp only [nodes] at hk; omega
        have hf : x ∉ M.fv ∧ x ∉ P.fv := by simpa only [fv, Finset.mem_union, not_or] using hx
        rw [subst_app]
        exact .app (ih M hm hf.1) (ih P hp hf.2)
      | lam y M =>
        have hm : M.nodes ≤ k := by simp only [nodes] at hk; omega
        rw [subst_lam]
        by_cases hy : y = x
        · rw [ite_eq_left hy]; exact .refl _
        · rw [ite_eq_right hy]
          have hmx : x ∉ M.fv := by simpa only [fv, Finset.mem_erase, ne_eq, Ne.symm hy, not_false_eq_true, true_and] using hx
          by_cases hn : y ∉ N.fv
          · rw [ite_eq_left hn]; exact .lam y (ih M hm hmx)
          · rw [ite_eq_right hn]
            let z := fresh (M.fv ∪ N.fv ∪ {x})
            have hz : z ∉ M.fv ∧ z ∉ N.fv ∧ z ≠ x := by
              simpa only [z, Finset.mem_union, Finset.mem_singleton, not_or, and_assoc]
                using fresh_not_mem (M.fv ∪ N.fv ∪ {x})
            have hr : x ∉ (M.subst y (.var z)).fv := by
              simp only [mem_fv_subst, fv, Finset.mem_singleton, hmx, false_and, false_or]
              exact fun h => hz.2.2 h.2.symm
            exact (RenameEq.lam z (ih (M.subst y (.var z)) (by simpa only [nodes_subst_var] using hm) hr)).trans
              (.symm (.rename M y z hz.1))
  exact bounded M.nodes M le_rfl hx

theorem subst_self (M : Term) (x : ℕ) : M.subst x (.var x) = M := by
  induction M with
  | var v => by_cases h : v = x <;> simp [subst_var, h]
  | app M N ihM ihN => simp only [subst_app, ihM, ihN]
  | lam y M ih =>
    rw [subst_lam]
    by_cases hy : y = x
    · rw [ite_eq_left hy]
    · rw [ite_eq_right hy, ite_eq_left (by simpa only [fv, Finset.mem_singleton] using hy), ih]

/-- Only the outer constructor is recorded; variable names are irrelevant. -/
def constructorTag : Term → ℕ
  | .var _ => 0
  | .app _ _ => 1
  | .lam _ _ => 2

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: proposition
  title: Invariants of binder renaming
-/
theorem RenameEq.constructorTag_eq {M N : Term} (h : RenameEq M N) :
    M.constructorTag = N.constructorTag := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | app => rfl
  | lam => rfl
  | rename => rfl

/-- Variable-for-variable substitution preserves the outer constructor. -/
theorem constructorTag_substFuel_var (k : ℕ) (M : Term) (x z : ℕ) :
    (substFuel k M x (.var z)).constructorTag = M.constructorTag := by
  cases k with
  | zero => rfl
  | succ k =>
    cases M with
    | var y => simp only [substFuel]; split_ifs <;> rfl
    | app M N => rfl
    | lam y M => simp only [substFuel]; split_ifs <;> rfl

/-- A named term is redex-free when no application has an abstraction as operator. -/
def RedexFree : Term → Prop
  | .var _ => True
  | .app M N => M.RedexFree ∧ N.RedexFree ∧ M.constructorTag ≠ 2
  | .lam _ M => M.RedexFree

theorem redexFree_substFuel_var (k : ℕ) (M : Term) (x z : ℕ) :
    (substFuel k M x (.var z)).RedexFree ↔ M.RedexFree := by
  induction k generalizing M x z with
  | zero => rfl
  | succ k ih =>
    cases M with
    | var y => simp only [substFuel]; split_ifs <;> rfl
    | app M N => simp only [substFuel, RedexFree, ih, constructorTag_substFuel_var]
    | lam y M => simp only [substFuel]; split_ifs <;> simp only [RedexFree, ih]

theorem redexFree_subst_var (M : Term) (x z : ℕ) :
    (M.subst x (.var z)).RedexFree ↔ M.RedexFree :=
  redexFree_substFuel_var M.nodes M x z

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: proposition
  title: Invariants of binder renaming
-/
theorem RenameEq.redexFree_iff {M N : Term} (h : RenameEq M N) :
    M.RedexFree ↔ N.RedexFree := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | app hM hN ih₁ ih₂ => simp only [RedexFree, ih₁, ih₂, hM.constructorTag_eq]
  | lam x _ ih => exact ih
  | rename M x z hz => exact (redexFree_subst_var M x z).symm

theorem Beta.not_redexFree {M N : Term} (h : Beta M N) : ¬ M.RedexFree := by
  induction h with
  | contract => simp [RedexFree, constructorTag]
  | app_left _ _ ih => exact fun hf => ih hf.1
  | app_right _ _ ih => exact fun hf => ih hf.2.1
  | lam _ _ ih => exact ih

end PolishSpaceBook.NamedLambda.Term
