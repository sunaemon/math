module

public import PolishSpaceBook.LambdaNameCorrespondence

@[expose] public section

/-! # Alpha-classes, substitution and reduction of named lambda terms

Alpha-equivalence is generated by binder renaming. Substitution compatibility
and independence of contraction from named representatives use the direct
name-correspondence proofs; no auxiliary term representation is needed here.
-/
namespace PolishSpaceBook.NamedLambda
namespace Term

/-- Alpha-equivalence is generated by capture-avoiding binder renaming. -/
abbrev Alpha (M N : Term) : Prop := RenameEq M N

instance (M N : Term) : Decidable (Alpha M N) :=
  by
  letI : Decidable (NameRel Eq M N) := NameRel.decidable Eq (fun _ _ => inferInstance) M N
  exact decidable_of_iff (NameRel Eq M N) (renameEq_iff_nameRel M N).symm

@[refl] theorem Alpha.refl (M : Term) : Alpha M M := RenameEq.refl M
@[symm] theorem Alpha.symm {M N : Term} (h : Alpha M N) : Alpha N M := RenameEq.symm h
@[trans] theorem Alpha.trans {M N P : Term} (h : Alpha M N) (h' : Alpha N P) :
    Alpha M P := RenameEq.trans h h'

theorem Alpha.app {M M' N N' : Term} (hM : Alpha M M') (hN : Alpha N N') :
    Alpha (app M N) (app M' N') := RenameEq.app hM hN

theorem Alpha.lam {M M' : Term} (hM : Alpha M M') (x : ℕ) :
    Alpha (lam x M) (lam x M') := RenameEq.lam x hM

theorem Alpha.fv_eq {M N : Term} (h : Alpha M N) : M.fv = N.fv := RenameEq.fv_eq h

theorem Alpha.closed_iff {M N : Term} (h : Alpha M N) : M.Closed ↔ N.Closed := by
  unfold Closed; rw [h.fv_eq]

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: theorem
  title: Alpha-equivalence by renaming
-/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    \begin{proof}[Proof]
    By \termuse{Named-term comparison}, alpha-equivalence is comparison under equality of free names, so it is decidable. Apply \termuse{Substitution under corresponding names} with both variable relations equal to equality and with the same variable replaced on both sides. The hypotheses hold, and the conclusion gives the asserted alpha-equivalence after substitution. For two choices of a fresh binder, both resulting abstractions are alpha-equivalent to the original one by a generating renaming. Symmetry and transitivity give their alpha-equivalence.
    \end{proof}
-/
theorem Alpha.subst {M M' N N' : Term} (hM : Alpha M M') (hN : Alpha N N') (x : ℕ) :
    Alpha (M.subst x N) (M'.subst x N') :=
  hM.subst_named hN x

theorem alpha_rename (M : Term) (x z : ℕ) (hz : z ∉ M.fv) :
    Alpha (lam x M) (lam z (M.subst x (var z))) := RenameEq.rename M x z hz

theorem alpha_fresh_choice (M : Term) (x z w : ℕ) (hz : z ∉ M.fv) (hw : w ∉ M.fv) :
    Alpha (lam z (M.subst x (var z))) (lam w (M.subst x (var w))) :=
  (alpha_rename M x z hz).symm.trans (alpha_rename M x w hw)

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: lemma
  title: Beta-reduction on alpha-classes
-/
theorem alpha_contract {M M' N N' : Term} {x y : ℕ}
    (hM : Alpha (lam x M) (lam y M')) (hN : Alpha N N') :
    Alpha (M.subst x N) (M'.subst y N') :=
  hM.contract_named hN

theorem Alpha.rename_bodies {M N : Term} {x y : ℕ}
    (h : Alpha (Term.lam x M) (Term.lam y N)) (z : ℕ) :
    Alpha (M.subst x (var z)) (N.subst y (var z)) := alpha_contract h (.refl _)

theorem RenameEq.alpha {M N : Term} (h : RenameEq M N) : Alpha M N := h

theorem alpha_iff_renameEq (M N : Term) : Alpha M N ↔ RenameEq M N := Iff.rfl


end Term

def alphaSetoid : Setoid Term where
  r := Term.Alpha
  iseqv := ⟨Term.Alpha.refl, Term.Alpha.symm, Term.Alpha.trans⟩

/-- Lambda terms with bound-variable names identified. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    From now on, terms are identified under alpha-equivalence. A term with no free variables is
    \termdefineas{closed lambda term}{closed}. A one-step
    \termdefine{beta-reduction} is
    the least relation $\to_\beta$ on lambda terms satisfying the following rules:
    $$
    \dfrac{}{\;(\lambdaab{x}{B})A \to_\beta B\subst{x}{A}\;}\;(\beta)
    $$
    and the context-closure rules
    $$
    \dfrac{R\to_\beta R'}{RS\to_\beta R'S}\;(\mathrm{App}_L)
    \qquad
    \dfrac{S\to_\beta S'}{RS\to_\beta RS'}\;(\mathrm{App}_R)
    \qquad
    \dfrac{B\to_\beta B'}{\lambdaab{x}{B}\to_\beta \lambdaab{x}{B'}}\;(\lambda).
    $$
    The rule $(\beta)$ contracts an actual redex and uses the capture-avoiding substitution just defined. The context rules
    say that the outermost term need not itself have the form $(\lambdaab{x}{B})A$: a beta step may occur in the left side
    of an application, in the right side of an application, or in the body of an abstraction. The reflexive transitive
    closure of $\to_\beta$ is written $\to_\beta^*$.
-/
def AlphaTerm := Quotient alphaSetoid

namespace AlphaTerm

def mk (M : Term) : AlphaTerm := Quotient.mk alphaSetoid M

def app : AlphaTerm → AlphaTerm → AlphaTerm :=
  Quotient.map₂ Term.app (by intro a b hM c d hN; exact Term.Alpha.app hM hN)

def lam (x : ℕ) : AlphaTerm → AlphaTerm :=
  Quotient.map (Term.lam x) (by intro a b h; exact Term.Alpha.lam h x)

def subst (M : AlphaTerm) (x : ℕ) (N : AlphaTerm) : AlphaTerm :=
  Quotient.map₂ (fun (A B : Term) => Term.subst A x B)
    (by intro a b hM c d hN; exact Term.Alpha.subst hM hN x) M N

def fv : AlphaTerm → Finset ℕ := Quotient.lift Term.fv (fun _ _ h => Term.Alpha.fv_eq h)

@[simp] theorem app_mk (M N : Term) : app (mk M) (mk N) = mk (Term.app M N) := rfl
@[simp] theorem lam_mk (x : ℕ) (M : Term) : lam x (mk M) = mk (Term.lam x M) := rfl
@[simp] theorem subst_mk (M N : Term) (x : ℕ) : subst (mk M) x (mk N) = mk (M.subst x N) := rfl
@[simp] theorem fv_mk (M : Term) : (mk M).fv = M.fv := rfl

theorem mk_eq_iff (M N : Term) : mk M = mk N ↔ M.Alpha N := Quotient.eq

/-- The displayed beta rules act on alpha-classes through the operations just constructed. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: lemma
  title: Beta-reduction on alpha-classes
-/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    From now on, terms are identified under alpha-equivalence. A term with no free variables is
    \termdefineas{closed lambda term}{closed}. A one-step
    \termdefine{beta-reduction} is
    the least relation $\to_\beta$ on lambda terms satisfying the following rules:
    $$
    \dfrac{}{\;(\lambdaab{x}{B})A \to_\beta B\subst{x}{A}\;}\;(\beta)
    $$
    and the context-closure rules
    $$
    \dfrac{R\to_\beta R'}{RS\to_\beta R'S}\;(\mathrm{App}_L)
    \qquad
    \dfrac{S\to_\beta S'}{RS\to_\beta RS'}\;(\mathrm{App}_R)
    \qquad
    \dfrac{B\to_\beta B'}{\lambdaab{x}{B}\to_\beta \lambdaab{x}{B'}}\;(\lambda).
    $$
    The rule $(\beta)$ contracts an actual redex and uses the capture-avoiding substitution just defined. The context rules
    say that the outermost term need not itself have the form $(\lambdaab{x}{B})A$: a beta step may occur in the left side
    of an application, in the right side of an application, or in the body of an abstraction. The reflexive transitive
    closure of $\to_\beta$ is written $\to_\beta^*$.
-/
inductive Beta : AlphaTerm → AlphaTerm → Prop where
  | contract (x : ℕ) (M N : AlphaTerm) : Beta (app (lam x M) N) (subst M x N)
  | app_left {M M' : AlphaTerm} (N : AlphaTerm) : Beta M M' → Beta (app M N) (app M' N)
  | app_right (M : AlphaTerm) {N N' : AlphaTerm} : Beta N N' → Beta (app M N) (app M N')
  | lam (x : ℕ) {M M' : AlphaTerm} : Beta M M' → Beta (lam x M) (lam x M')

theorem beta_of_raw {M N : Term} (h : Term.Beta M N) : Beta (mk M) (mk N) := by
  induction h with
  | contract x M N => exact .contract x (mk M) (mk N)
  | app_left N _ ih => exact .app_left (mk N) ih
  | app_right M _ ih => exact .app_right (mk M) ih
  | lam x _ ih => exact .lam x ih

/-- A class step is exactly a raw step between some representatives. -/
theorem Beta.exists_raw {P Q : AlphaTerm} (h : Beta P Q) :
    ∃ M N : Term, mk M = P ∧ mk N = Q ∧ Term.Beta M N := by
  induction h with
  | contract x M N =>
    refine Quotient.inductionOn₂ M N ?_
    intro A B
    exact ⟨Term.app (Term.lam x A) B, A.subst x B, rfl, rfl, .contract x A B⟩
  | app_left P _ ih =>
    rcases ih with ⟨M, N, rfl, rfl, h⟩
    refine Quotient.inductionOn P ?_
    intro A
    exact ⟨Term.app M A, Term.app N A, rfl, rfl, .app_left A h⟩
  | app_right P _ ih =>
    rcases ih with ⟨M, N, rfl, rfl, h⟩
    refine Quotient.inductionOn P ?_
    intro A
    exact ⟨Term.app A M, Term.app A N, rfl, rfl, .app_right A h⟩
  | lam x _ ih =>
    rcases ih with ⟨M, N, rfl, rfl, h⟩
    exact ⟨Term.lam x M, Term.lam x N, rfl, rfl, .lam x h⟩

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: lemma
  title: Beta-reduction on alpha-classes
-/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    Generate reduction on classes by the contraction and context rules using these quotient operations. Every named reduction projects to such a reduction by induction on its derivation. Conversely, a contraction of classes is witnessed by representatives of its body and argument. For each application context, take the representatives supplied by the induction hypothesis for the reduced side and any representative of the other side. For an abstraction context, put the specified binder around the two representatives supplied by the hypothesis. This proves the converse by induction on the derivation of a class reduction. Hence the rules introduce precisely named reductions modulo alpha-equivalence.
-/
theorem beta_iff_raw (P Q : AlphaTerm) :
    Beta P Q ↔ ∃ M N : Term, mk M = P ∧ mk N = Q ∧ Term.Beta M N := by
  refine ⟨Beta.exists_raw, ?_⟩
  rintro ⟨M, N, rfl, rfl, h⟩
  exact beta_of_raw h

theorem Beta.fv_subset {P Q : AlphaTerm} (h : Beta P Q) : Q.fv ⊆ P.fv := by
  rcases Beta.exists_raw h with ⟨M, N, hM, hN, hraw⟩
  rw [← hM, ← hN]
  exact Term.Beta.fv_subset hraw

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: corollary
  title: Free variables under beta-reduction
-/
theorem beta_steps_fv_subset {P Q : AlphaTerm} (h : Relation.ReflTransGen Beta P Q) :
    Q.fv ⊆ P.fv := by
  induction h with
  | refl => exact Finset.Subset.refl _
  | tail _ h ih => exact Finset.Subset.trans h.fv_subset ih

def Closed (P : AlphaTerm) : Prop := P.fv = ∅

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: corollary
  title: Free variables under beta-reduction
-/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    Free-variable sets are constant on alpha-classes. For a class reduction, use \termuse{Beta-reduction on alpha-classes} to choose named representatives and apply the one-step inclusion to them. The same finite-reduction induction therefore proves the assertion after identifying bound-variable names as well.
-/
theorem closed_of_beta_steps {P Q : AlphaTerm} (hP : P.Closed)
    (h : Relation.ReflTransGen Beta P Q) : Q.Closed := by
  have hs := beta_steps_fv_subset h
  rw [hP] at hs
  exact Finset.subset_empty.mp hs

end AlphaTerm
end PolishSpaceBook.NamedLambda
