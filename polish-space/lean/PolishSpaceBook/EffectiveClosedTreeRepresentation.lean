module

public import PolishSpaceBook.LambdaRelativeEnumerations
public import PolishSpaceBook.LambdaComputableNames

@[expose] public section

/-! # Effective closed-set tree representation by lambda programs

Finite acceptance certificates totalize any nonempty forbidden family.
The resulting stage-cutoff decider uses the same fixed parameter throughout.
The parameter-free case specializes that parameter to the constant-zero name;
substituting its closed numerical term yields ordinary beta computations.
-/
namespace PolishSpaceBook
open NamedLambda NamedLambda.AlphaTerm
local instance : Encodable (List ℕ) := NatListCode.encodable

/-- With a computable zero parameter, the enumerator is an ordinary numerical lambda term. -/
theorem LambdaRelative.SemidecidablePredicate.total_numerical_enumeration {R : ℕ → Prop}
    (hR : LambdaRelative.SemidecidablePredicate (fun _ => 0) R) (hne : ∃ a, R a) :
    ∃ (f : ℕ → ℕ) (F : AlphaTerm), NumericalComputes F f ∧ ∀ a, R a ↔ a ∈ Set.range f := by
  obtain ⟨f,⟨P,hP⟩,hr⟩ := hR.total_enumeration hne
  refine ⟨f,app P (numericalConstant 0),⟨closed_app hP.1 (numericalConstant_computes 0).1,?_⟩,hr⟩
  intro n
  exact (hP.2 n).apply_numerical hP.1 (numericalConstant_computes 0)

/-- A semidecidable family of forbidden words, with the book's list coding. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    For example, $\lSigma^0_1(a)$ consists of the open sets whose basic cylinders can be enumerated by a lambda program with
    input-function access to $a$:
    $$
    U\in\lSigma^0_1(a)
    \quad\Longleftrightarrow\quad
    U=\bigcup_{e\in W^a}\cyl{\sigma(e)}
    $$
    for some set $W^a\IncludedIn\omega$ recursively enumerable relative to $a$.
-/
def RelativelyEffectivelyOpen (ε : ℕ → ℕ) (U : Set (ℕ → ℕ)) : Prop :=
  ∃ W : Set (List ℕ), LambdaRelative.SemidecidablePredicate ε (· ∈ W) ∧ U = cylinderCode W

def RelativelyEffectivelyClosed (ε : ℕ → ℕ) (F : Set (ℕ → ℕ)) : Prop :=
  RelativelyEffectivelyOpen ε Fᶜ

/-- The fixed computable zero name supplies no noncomputable information. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The passage from boldface to lightface mirrors the passage from arbitrary open subsets of Baire space to recursively
    enumerable lists of cylinders. Topologically, an open set is a union of basic cylinders:
    $$U = \bigcup_{s \in A}\cyl{s} \qquad (A \IncludedIn \finseq{\omega}).$$
    $U$ is effectively open when it has such an enumeration of cylinders generated by a lambda program. The lambda-calculus
    appendix fixes the indexing convention; here we use it to put an algorithmic constraint on every construction.
-/
def EffectivelyOpen (U : Set (ℕ → ℕ)) : Prop := RelativelyEffectivelyOpen (fun _ => 0) U

def EffectivelyClosed (F : Set (ℕ → ℕ)) : Prop := EffectivelyOpen Fᶜ

/-- Rejecting words enumerate exactly the complement of a recursive tree body. -/
theorem recursive_tree_body_relativelyEffectivelyClosed (ε : ℕ → ℕ) (T : LambdaTree.PrefixTree ε) :
    RelativelyEffectivelyClosed ε (treeBody T.tree) := by
  refine ⟨T.treeᶜ,?_,compl_treeBody_eq_cylinderCode_compl T.tree⟩
  exact T.decidable.not.semidecidable

/-- A total enumerator suffices; the empty forbidden family gives the full tree. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: statement
  kind: theorem
  title: Effective closed-set tree representation
-/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: proof
  excerpt: |
    Work with one fixed parameter throughout. If membership in $T$ is decidable, its complement is decidable and
    hence semidecidable. The cylinders $\cyl{s}$ for $s\notin T$ have union exactly the complement of $[T]$,
    so $[T]$ is effectively closed relative to that parameter.

    Conversely, write the complement of $F$ as the union of cylinders from a semidecidable family $W$.
    If $W$ is empty, $F=\BaireSpace$ and the full tree has the required body; its constant-one decider makes no queries.
    If $W$ is nonempty, the preceding total-enumeration proposition supplies a sequence $s_0,s_1,\ldots$ with range $W$.
    Apply the relative stage-cutoff construction: membership is decided by the first $|t|+1$ prefix tests, with each
    zero-or-one answer complemented,
    and its body is the complement of exactly those cylinders. Thus $F=[T]$.
    For the parameter-free case use the constant-zero parameter. Substituting the closed constant-zero term in each
    total enumerator or decider produces ordinary beta computations, as §{sec:lambda-total-enumerations} explains.
-/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    Similarly, $\lPi^0_1(a)$ consists of
    complements of such sets, equivalently bodies $[T]$ of trees $T\IncludedIn\finseq{\omega}$ whose membership relation is
    recursive relative to $a$.
-/
theorem relativelyEffectivelyClosed_iff_recursive_tree (ε : ℕ → ℕ) (F : Set (ℕ → ℕ)) :
    RelativelyEffectivelyClosed ε F ↔ ∃ T : LambdaTree.PrefixTree ε, F = treeBody T.tree := by
  constructor
  · rintro ⟨W,hW,hF⟩
    by_cases hne : W.Nonempty
    · obtain ⟨f,P,hP,hrange⟩ := LambdaTree.total_word_enumeration hW hne
      refine ⟨LambdaTree.relativeStageCutoff ε f P hP,?_⟩
      rw [LambdaTree.relativeStageCutoff_body]
      apply compl_injective
      rw [compl_compl,hF]
      ext x
      simp only [mem_cylinderCode,Set.mem_iUnion]
      constructor
      · rintro ⟨s,hs,hx⟩
        obtain ⟨i,rfl⟩ := (hrange s).mp hs
        exact ⟨i,hx⟩
      · rintro ⟨i,hx⟩
        exact ⟨f i,(hrange _).mpr ⟨i,rfl⟩,hx⟩
    · have hempty : W = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have hFuniv : F = Set.univ := by
        apply compl_injective
        simpa [hempty,cylinderCode] using hF
      refine ⟨⟨Set.univ,fun _ _ _ _ => Set.mem_univ _,?_⟩,hFuniv.trans treeBody_univ.symm⟩
      exact LambdaRelative.decidablePredicate_true (List ℕ) ε
  · rintro ⟨T,rfl⟩
    exact recursive_tree_body_relativelyEffectivelyClosed ε T

theorem recursive_tree_body_effectivelyClosed (T : RecursivePrefixTree) :
    EffectivelyClosed (treeBody T.tree) :=
  recursive_tree_body_relativelyEffectivelyClosed (fun _ => 0) T

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: statement
  kind: theorem
  title: Effective closed-set tree representation
-/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The effective closed-set tree representation proved in §{sec:edst-recursive-trees} says that $F\IncludedIn\BaireSpace$
    is $\lPi^0_1$ exactly when $F=[T]$ for a recursive tree $T\IncludedIn\finseq{\omega}$.
-/
theorem effectivelyClosed_iff_recursive_tree (F : Set (ℕ → ℕ)) :
    EffectivelyClosed F ↔ ∃ T : RecursivePrefixTree, F = treeBody T.tree :=
  relativelyEffectivelyClosed_iff_recursive_tree (fun _ => 0) F

/-- The zero-name presentation has an ordinary, closed numerical membership decider. -/
/-@ booklink:
  source: polish-space-book/appendix-effective-computational-constructions.md
  target: prose
  excerpt: |
    For the parameter-free application, take $\varepsilon(k)=0$ for every $k$ and substitute the closed numerical
    term $\lambdaab{k}{\ChurchNumeral{0}}$ for the input argument. The substitution theorem of
    §{sec:lambda-input-composition} replaces every query by ordinary beta reduction. Thus both the total
    enumerator and every total tree decider above have ordinary closed numerical implementations. This establishes
    the unrelativized closed-set tree representation as well as its fixed-parameter version. The empty forbidden
    family is handled separately by the full tree and its constant-one decider.
-/
theorem RecursivePrefixTree.ordinary_decider (T : RecursivePrefixTree) :
    ∃ P : AlphaTerm, P.Closed ∧ ∀ s : List ℕ,
      (s ∈ T.tree → Relation.ReflTransGen Beta (app P (numeral (NatListCode.encode s))) (numeral 1)) ∧
      (s ∉ T.tree → Relation.ReflTransGen Beta (app P (numeral (NatListCode.encode s))) (numeral 0)) := by
  obtain ⟨P,hP⟩ := T.decidable
  refine ⟨app P (numericalConstant 0),closed_app hP.1 (numericalConstant_computes 0).1,fun s => ⟨?_,?_⟩⟩
  · intro hs
    exact ((hP.2 s).1 hs).apply_numerical hP.1 (numericalConstant_computes 0)
  · intro hs
    exact ((hP.2 s).2 hs).apply_numerical hP.1 (numericalConstant_computes 0)

end PolishSpaceBook
