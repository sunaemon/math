module

public import Mathlib.MeasureTheory.PiSystem

@[expose] public section

/-! # Dynkin's pi-lambda theorem through two intersection-test systems -/

namespace PolishSpaceBook.DynkinPiLambda
open Set MeasurableSpace MeasureTheory
open scoped Function

variable {X : Type*}

/-- Fixing one member of a Dynkin system gives the intersection-test system in the book. -/
/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: proof
  excerpt: |
    Let $\mathcal D_0$ be the smallest Dynkin system containing $\mathcal P$.
    For any $A\in\mathcal D_0$, consider
    $$\mathcal D_A:=\{B:A\cap B\in\mathcal D_0\}.$$
    This is a Dynkin system. It contains $\emptyset$. For complementation, use
    $$A\cap B^c=\SetDifference{A}{A\cap B}.$$
    A Dynkin system is closed under differences of nested members: if $E\IncludedIn A$ and both sets belong to it,
    then $\SetDifference{A}{E}=(E\cup A^c)^c$ belongs to it, since $E$ and $A^c$ are disjoint.
    Intersections with $A$ distribute over countable unions and preserve disjointness, giving the remaining closure.
-/
def intersectionTests (D : DynkinSystem X) (A : Set X) (hA : D.Has A) : DynkinSystem X where
  Has B := D.Has (A ∩ B)
  has_empty := by simpa using D.has_empty
  has_compl := by
    intro B hB
    have he : A ∩ Bᶜ = A \ (A ∩ B) := by ext x; simp
    rw [he]
    exact D.has_sdiff hA hB inter_subset_left
  has_iUnion_nat := by
    intro B hdis hB
    rw [inter_iUnion]
    apply D.has_iUnion_nat _ hB
    intro i j hij
    exact (hdis hij).mono inter_subset_right inter_subset_right

/-- First fix a generator, then extend the second argument to the generated Dynkin system. -/
lemma generated_inter_basic {P : Set (Set X)} (hP : IsPiSystem P)
    {A B : Set X} (hA : A ∈ P) (hB : (DynkinSystem.generate P).Has B) :
    (DynkinSystem.generate P).Has (A ∩ B) := by
  let D₀ := DynkinSystem.generate P
  have hA₀ : D₀.Has A := DynkinSystem.GenerateHas.basic A hA
  have hmin : D₀ ≤ intersectionTests D₀ A hA₀ := by
    apply DynkinSystem.generate_le
    intro C hC
    change D₀.Has (A ∩ C)
    rcases (A ∩ C).eq_empty_or_nonempty with he | hne
    · rw [he]; exact D₀.has_empty
    · exact DynkinSystem.GenerateHas.basic _ (hP A hA C hC hne)
  exact hmin B hB

/-- A second application of minimality extends the first argument too. -/
/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: proof
  excerpt: |
    First fix $A\in\mathcal P$. The $\pi$-system property implies $\mathcal P\IncludedIn\mathcal D_A$,
    so minimality gives $\mathcal D_0\IncludedIn\mathcal D_A$.
    Thus $A\cap B\in\mathcal D_0$ whenever $A\in\mathcal P$ and $B\in\mathcal D_0$.
    Now fix $B\in\mathcal D_0$. By this conclusion and commutativity of intersection,
    $\mathcal P\IncludedIn\mathcal D_B$, so minimality gives $\mathcal D_0\IncludedIn\mathcal D_B$.
    Hence $\mathcal D_0$ is closed under binary intersections.
-/
lemma generated_inter {P : Set (Set X)} (hP : IsPiSystem P)
    {A B : Set X} (hA : (DynkinSystem.generate P).Has A)
    (hB : (DynkinSystem.generate P).Has B) :
    (DynkinSystem.generate P).Has (A ∩ B) := by
  have hmin : DynkinSystem.generate P ≤ intersectionTests (DynkinSystem.generate P) B hB := by
    apply DynkinSystem.generate_le
    intro C hC
    change (DynkinSystem.generate P).Has (B ∩ C)
    rw [inter_comm]
    exact generated_inter_basic hP hC hB
  have h := hmin A hA
  change (DynkinSystem.generate P).Has (B ∩ A) at h
  rwa [inter_comm] at h

/-- The generated Dynkin system is a sigma-algebra, hence every containing Dynkin system
contains all sets generated by the pi-system. -/
/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: proof
  excerpt: |
    It is therefore closed under finite unions and differences as well. For any sequence $E_n\in\mathcal D_0$,
    put
    $$E'_n:=\SetDifference{E_n}{\bigcup_{i<n}E_i}.$$
    These sets belong to $\mathcal D_0$, are pairwise disjoint, and have the same union as the $E_n$.
    The Dynkin closure now gives $\bigcup_nE_n\in\mathcal D_0$.
    Thus $\mathcal D_0$ is a $\sigma$-algebra containing $\mathcal P$, and
    $\sigma(\mathcal P)\IncludedIn\mathcal D_0\IncludedIn\mathcal D$.
-/
/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: statement
  excerpt: |
    \begin{lemma*}[\termdefineas{Dynkin pi-lambda theorem}{Dynkin's $\pi$-$\lambda$ theorem}]
-/
theorem pi_lambda {P : Set (Set X)} (hP : IsPiSystem P) (D : DynkinSystem X)
    (hPD : ∀ A ∈ P, D.Has A) {A : Set X} (hA : MeasurableSet[generateFrom P] A) : D.Has A := by
  let D₀ := DynkinSystem.generate P
  let m : MeasurableSpace X := D₀.toMeasurableSpace (fun _ _ => generated_inter hP)
  have hgen : generateFrom P ≤ m := generateFrom_le fun A hA => DynkinSystem.GenerateHas.basic A hA
  exact DynkinSystem.generate_le D hPD A (hgen A hA)

/-- A reusable, proof-independent induction principle derived from the explicit pi-lambda proof. -/
theorem induction_on_pi {P : Set (Set X)} (hP : IsPiSystem P) {C : Set X → Prop}
    (hempty : C ∅) (hbasic : ∀ A ∈ P, C A)
    (hcompl : ∀ A, MeasurableSet[generateFrom P] A → C A → C Aᶜ)
    (hunion : ∀ A : ℕ → Set X, Pairwise (Disjoint on A) →
      (∀ n, MeasurableSet[generateFrom P] (A n)) → (∀ n, C (A n)) → C (⋃ n, A n))
    {A : Set X} (hA : MeasurableSet[generateFrom P] A) : C A := by
  let : MeasurableSpace X := generateFrom P
  let D : DynkinSystem X := {
    Has := fun B => MeasurableSet[generateFrom P] B ∧ C B
    has_empty := ⟨MeasurableSet.empty, hempty⟩
    has_compl := fun h => ⟨h.1.compl, hcompl _ h.1 h.2⟩
    has_iUnion_nat := fun hd h => ⟨MeasurableSet.iUnion (fun n => (h n).1),
      hunion _ hd (fun n => (h n).1) (fun n => (h n).2)⟩ }
  exact (pi_lambda hP D (fun B hB => ⟨measurableSet_generateFrom hB, hbasic B hB⟩) hA).2

/-- The same principle with an explicitly identified ambient sigma-algebra. -/
theorem induction_on_inter {m : MeasurableSpace X} {P : Set (Set X)} {C : Set X → Prop}
    (hgen : m = generateFrom P) (hP : IsPiSystem P)
    (hempty : C ∅) (hbasic : ∀ A ∈ P, C A)
    (hcompl : ∀ A, MeasurableSet[m] A → C A → C Aᶜ)
    (hunion : ∀ A : ℕ → Set X, Pairwise (Disjoint on A) →
      (∀ n, MeasurableSet[m] (A n)) → (∀ n, C (A n)) → C (⋃ n, A n)) :
    ∀ A, MeasurableSet[m] A → C A := by
  subst m
  exact fun _ hA => induction_on_pi hP hempty hbasic hcompl hunion hA

end PolishSpaceBook.DynkinPiLambda
