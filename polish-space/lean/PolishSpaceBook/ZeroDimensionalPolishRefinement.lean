/-@ booklink:
  source: polish-space-book/polish-embeddings-borel-refinements.md
  target: prose
  excerpt: |
    By definition of standard Borel, fix any Polish topology $\tau_0$ on $X$ with
    $\mathcal B(\tau_0) = \mathcal B$. From there, (1) is the zero-dimensional form of
    \termuse{Kuratowski's refinement theorem} applied to $\tau_0$ and $\{B_n\}$. Apply the zero-dimensional part of
    \termuse{closed presentation in Baire space} to that same topology to obtain (2); the $B_n$ remain clopen. Finally, (3)
    is the countable-map variant of \termuse{Borel maps become continuous}.
-/
/-@ booklink:
  source: polish-space-book/polish-embeddings-borel-refinements.md
  target: statement
  kind: theorem
  title: Kuratowski's refinement theorem
-/
theorem exists_zero_dimensional_refinement_clopen {X : Type} [t : TopologicalSpace X]
    [PolishSpace X] [MeasurableSpace X] [BorelSpace X]
    (B : ℕ → Set X) (hB : ∀ n, MeasurableSet (B n)) :
    ∃ t' : TopologicalSpace X, t' ≤ t ∧ @PolishSpace X t' ∧
      @borel X t' = @borel X t ∧ @HasSmallInductiveDimensionLE X t' 0 ∧
      ∀ n, @IsClopen X t' (B n) := by
  obtain ⟨s, hst, hsp, hsb, hsc⟩ := exists_polish_refinement_clopen B hB
  obtain ⟨r, hrs, hrp, hrb, hrz⟩ := @exists_zero_dimensional_polish_refinement X s hsp
  refine ⟨r, hrs.trans hst, hrp, hrb.trans hsb, hrz, fun n => ?_⟩
  exact ⟨(hsc n).1.mono hrs, (hsc n).2.mono hrs⟩

/-@ booklink:
  source: polish-space-book/polish-embeddings-borel-refinements.md
  target: statement
  kind: corollary
  title: Closed presentation in Baire space
-/
/-@ booklink:
  source: polish-space-book/polish-embeddings-borel-refinements.md
  target: prose
  excerpt: |
    For a general Polish space $(X,\tau)$, use the zero-dimensional conclusion of
    \termuse{Kuratowski's refinement theorem}. The refined topology $\tau'$ is Polish, has the same Borel
    $\sigma$-algebra, is finer than $\tau$, and is zero-dimensional. The zero-dimensional statement then embeds
    $(X,\tau')$ as a closed subspace of $\BaireSpace$.
-/
/-- A general Polish space admits a continuous Borel isomorphism from a
closed subspace of Baire space. Its inverse is Borel, but need not be
continuous in the original topology. -/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    Use a finer zero-dimensional Polish topology with the same Borel sets as in §{sec:polish-topology-refinement}, and
    a closed Baire-space presentation as in §{sec:closed-presentation-baire}.
-/
theorem exists_continuous_closed_baire_presentation (X : Type) [t : TopologicalSpace X]
    [PolishSpace X] :
    ∃ F : Set (ℕ → ℕ), IsClosed F ∧ ∃ e : F ≃ X,
      Continuous e ∧ @Measurable X F (borel X) (borel F) e.symm := by
  obtain ⟨s, hst, hsp, hsb, hsz⟩ := exists_zero_dimensional_polish_refinement X
  obtain ⟨F, hF, ⟨e⟩⟩ := @exists_zero_dimensional_closed_presentation X s hsp hsz
  refine ⟨F, hF, e.symm.toEquiv, ?_, ?_⟩
  · exact @Continuous.comp F X X _ s t e.symm id
      (continuous_id_iff_le.mpr hst) e.symm.continuous
  · change @Measurable X F (@borel X t) (borel F) e
    rw [← hsb]
    exact @Continuous.borel_measurable X F s _ e e.continuous

end PolishSpaceBook
