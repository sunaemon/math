@[expose] public section

/-!
# The graph construction of a zero-dimensional Polish refinement

The graph of the membership bits of a countable open basis is G-delta. Its
pulled-back topology is also induced by the bits alone, since the old basis
is recovered from the coordinate tests. Borel equality follows directly from
measurability of the graph map, without Lusin--Souslin.
-/
namespace PolishSpaceBook
open Set TopologicalSpace Topology MeasureTheory

/-@ booklink:
  source: polish-space-book/polish-embeddings-borel-refinements.md
  target: prose
  excerpt: |
    It remains to prove the zero-dimensional addendum. We show that any Polish topology admits a zero-dimensional
    Polish refinement with the same Borel sets.
-/
/-@ booklink:
  source: polish-space-book/polish-embeddings-borel-refinements.md
  target: prose
  excerpt: |
    Choose a countable base $\{U_k\}$ for $\tau$ and let
    $$
    e:X\to X\times \CantorSpace,\qquad e(x)=(x,\Sequence{\mathbf 1_{U_k}(x)}{k\in\omega}),
    $$
    and give $X$ the topology pulled back from the product. This topology is generated by the sets $U_k$ and
    $\SetDifference{X}{U_k}$, so it is zero-dimensional and refines $\tau$. Its image is the set of all $(x,a)$ satisfying,
    for every $k$,
    $$
    a(k)=1\Longleftrightarrow x\in U_k.
    $$
    For each $k$, write $C^1_k=\{a:a(k)=1\}$ and $C^0_k=\{a:a(k)=0\}$. The $k$th condition is
    $$
    \bigl(U_k\times C^1_k\bigr)\cup\bigl((\SetDifference{X}{U_k})\times C^0_k\bigr),
    $$
    a $\Gdelta$ subset of $X\times \CantorSpace$. The first piece is open, while the second is closed and hence $\Gdelta$ by
    §{sec:alexandrov-theorem}; finite unions of $\Gdelta$ sets are $\Gdelta$. Thus the image of $e$ is $\Gdelta$ in
    $X\times \CantorSpace$, and the pulled-back topology is Polish. It has the countable $\tau$-Borel subbasis
    $\{U_k,\SetDifference{X}{U_k}:k\in\omega\}$. Hence every new open set is a countable union of finite intersections of
    $\tau$-Borel sets, so its Borel sets are still $\mathcal B(\tau)$.
-/
/-- The graph refinement from the book, with its Borel equality proved by
countable coordinate measurability rather than comparable-Polish-topology
invariance. -/
theorem exists_zero_dimensional_polish_refinement (X : Type) [t : TopologicalSpace X]
    [PolishSpace X] : ∃ t' : TopologicalSpace X, t' ≤ t ∧ @PolishSpace X t' ∧
      @borel X t' = @borel X t ∧ @HasSmallInductiveDimensionLE X t' 0 := by
  classical
  let : PolishSpace (ℕ → Bool) := cantor_space_polish
  obtain ⟨U, hU⟩ := exists_seq_basis X
  have hUo n : IsOpen (U n) := hU.isOpen ⟨n, rfl⟩
  let c : X → (ℕ → Bool) := fun x n => if x ∈ U n then true else false
  let g : X → X × (ℕ → Bool) := fun x => (x, c x)
  have hbit (n : ℕ) (b : Bool) : IsClopen {a : ℕ → Bool | a n = b} :=
    (isClopen_discrete {b}).preimage (continuous_apply n)
  have hgdelta : IsGδ (range g) := by
    have heq : range g = ⋂ n, (U n ×ˢ {a : ℕ → Bool | a n = true}) ∪
        ((U n)ᶜ ×ˢ {a : ℕ → Bool | a n = false}) := by
      ext p
      have hclause n : p ∈ (U n ×ˢ {a : ℕ → Bool | a n = true}) ∪
          ((U n)ᶜ ×ˢ {a : ℕ → Bool | a n = false}) ↔ p.2 n = c p.1 n := by
        by_cases h : p.1 ∈ U n <;> simp [c, h]
      simp only [mem_iInter, hclause]
      constructor
      · rintro ⟨x, rfl⟩ n
        rfl
      · intro h
        exact ⟨p.1, Prod.ext rfl (funext h).symm⟩
    rw [heq]
    apply IsGδ.iInter
    intro n
    exact ((hUo n).prod (hbit n true).isOpen).isGδ.union
      (((hUo n).isClosed_compl).prod (hbit n false).isClosed).isGδ
  have hgm : @Measurable X (X × (ℕ → Bool)) (borel X) (borel (X × (ℕ → Bool))) g := by
    let : MeasurableSpace X := borel X
    let : BorelSpace X := ⟨rfl⟩
    have hc : Measurable c := by
      apply Measurable.of_eval
      intro n
      exact measurable_const.piecewise (hUo n).measurableSet measurable_const
    exact (measurable_id.prodMk hc).mono le_rfl
      (le_of_eq (BorelSpace.measurable_eq (α := X × (ℕ → Bool))).symm)
  let tP := @instTopologicalSpaceProd X (ℕ → Bool) t inferInstance
  have hpRange : @PolishSpace (range g) (TopologicalSpace.induced Subtype.val tP) :=
    gdelta_subspace_polish hgdelta
  let tc := TopologicalSpace.induced c inferInstance
  let tg := TopologicalSpace.induced g tP
  have hccont : @Continuous X (ℕ → Bool) tc inferInstance c := continuous_induced_dom
  have hid : @Continuous X X tc t id := by
    apply (@TopologicalSpace.IsTopologicalBasis.continuous_iff X X tc t _ hU id).mpr
    rintro _ ⟨n, rfl⟩
    have heq : c ⁻¹' {a : ℕ → Bool | a n = true} = U n := by
      ext x
      simp [c]
    rw [show id ⁻¹' U n = U n from rfl, ← heq]
    exact @IsOpen.preimage X (ℕ → Bool) tc _ c hccont _ (hbit n true).isOpen
  have hgc : @Continuous X (X × (ℕ → Bool)) tc tP g :=
    @Continuous.prodMk X (ℕ → Bool) X t _ tc id c hid hccont
  have heq : tg = tc := by
    apply le_antisymm
    · apply continuous_iff_le_induced.mp
      exact @Continuous.comp X (X × (ℕ → Bool)) (ℕ → Bool) tg tP _ g Prod.snd
        (@continuous_snd X (ℕ → Bool) t _) continuous_induced_dom
    · exact continuous_iff_le_induced.mp hgc
  have hle : tg ≤ t := by
    rw [heq]
    simpa only [induced_id] using continuous_iff_le_induced.mp hid
  have hp : @PolishSpace X tg := by
    let e : @Homeomorph X (range g) tg (TopologicalSpace.induced Subtype.val tP) :=
      @IsEmbedding.toHomeomorph X (X × (ℕ → Bool)) tg tP g
        ⟨⟨rfl⟩, fun x y h => congrArg Prod.fst h⟩
    exact @IsClosedEmbedding.polishSpace X (range g) tg _ hpRange e
      (@Homeomorph.isClosedEmbedding X (range g) tg _ e)
  have hb : @borel X tg = @borel X t := by
    refine le_antisymm ?_ (borel_anti hle)
    rw [borel_comap]
    exact hgm.comap_le
  have hz : @IsZeroDimensional X tg := by
    rw [heq]
    exact isZeroDimensional_induced cantor_space_zero_dimensional c
  exact ⟨tg, hle, hp, hb, (@zero_dimensional_iff_small_inductive X tg).mp hz⟩

