module

public import PolishSpaceBook.LambdaSyntaxCoding
public import PolishSpaceBook.LambdaNumericalFunctions
public import Mathlib.SetTheory.Ordinal.Rank
public import Mathlib.SetTheory.Cardinal.Ordinal

@[expose] public section

/-! # Kleene notation rules using closed lambda program indices

The auxiliary edge relation may mention invalid numbers. Validity is the
least predicate generated by the zero, successor and increasing-limit rules.
Below a valid target all auxiliary predecessors are valid and accessible.
The restriction therefore agrees with precedence generated by valid rules.
-/
namespace PolishSpaceBook
open NamedLambda NamedLambda.AlphaTerm
namespace KleeneNotation

def successorCode (a : ℕ) : ℕ := 2^a
def limitCode (e : ℕ) : ℕ := 3*5^e

def Runs (e n a : ℕ) : Prop :=
  Relation.ReflTransGen Beta (app (Term.closedProgram e) (numeral n)) (numeral a)

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: prose
  excerpt: |
    We construct \termdefineas{Kleene's ordinal notations}{Kleene's system of ordinal notations} $\KleeneO$ using the
    ordinary unary program enumeration from §{sec:lambda-universal-evaluation}. Thus $\varphi_e(n)=m$ means that the
    closed lambda program $P_e$ applied to $\ChurchNumeral{n}$ reduces to $\ChurchNumeral{m}$ by finitely many beta steps.
    Here no input oracle is supplied. Numerical output is unique.
-/
theorem runs_unique {e n a b : ℕ} (ha : Runs e n a) (hb : Runs e n b) : a = b :=
  numeral_output_unique ha hb

theorem successorCode_injective : Function.Injective successorCode :=
  Nat.pow_right_injective (by decide)

theorem limitCode_injective : Function.Injective limitCode := by
  intro a b h
  have hp : 5^a = 5^b := by unfold limitCode at h; omega
  exact Nat.pow_right_injective (by decide) hp

theorem successorCode_pos (a : ℕ) : 0 < successorCode a := pow_pos (by decide) a

theorem limitCode_ge_three (e : ℕ) : 3 ≤ limitCode e := by
  have h : 0 < 5^e := pow_pos (by decide) e
  unfold limitCode
  omega

theorem successorCode_ne_limitCode (a e : ℕ) : successorCode a ≠ limitCode e := by
  intro h
  cases a with
  | zero => have := limitCode_ge_three e; simp only [successorCode,pow_zero] at h; omega
  | succ a =>
    have hm := congrArg (fun n => n % 2) h
    simp [successorCode,limitCode,pow_succ,Nat.mul_mod,Nat.pow_mod] at hm

/-- A numerical candidate edge, with no assumption of notation validity. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: prose
  excerpt: |
    First define a candidate relation on all natural numbers by the rules
    $$\KleeneCandidateStep{a}{2^a}\quad(a>0),\qquad
    \KleeneCandidateStep{\varphi_e(n)}{3\cdot5^e}\quad(\varphi_e(n)\downarrow),$$
    and write $\KleeneCandidatePrecedes{a}{b}$ for its transitive closure. These rules do not yet assert that any of the
    numbers are valid notations. Define $\KleeneO$ as the least set closed under the following rules: $1\in\KleeneO$;
    if $a\in\KleeneO$, then $2^a\in\KleeneO$; and if $\varphi_e$ is total, every $\varphi_e(n)$ belongs to
    $\KleeneO$, and $\KleeneCandidatePrecedes{\varphi_e(n)}{\varphi_e(n+1)}$ for every $n$, then
    $3\cdot5^e\in\KleeneO$. Finally, let $\KleenePrecedes{a}{b}$ be the transitive closure of the candidate steps
    whose target belongs to $\KleeneO$.
-/
inductive Edge : ℕ → ℕ → Prop
  | succ (a : ℕ) (ha : 0 < a) : Edge a (successorCode a)
  | limit (e n a : ℕ) (h : Runs e n a) : Edge a (limitCode e)

abbrev RawPrecedes := Relation.TransGen Edge

inductive Valid : ℕ → Prop
  | zero : Valid 1
  | succ {a : ℕ} (h : Valid a) : Valid (successorCode a)
  | limit (e : ℕ) (f : ℕ → ℕ) (hc : NumericalComputes (Term.closedProgram e) f)
      (hf : ∀ n, Valid (f n)) (hi : ∀ n, RawPrecedes (f n) (f (n+1))) : Valid (limitCode e)

theorem Valid.pos {a : ℕ} (h : Valid a) : 0 < a := by
  cases h with
  | zero => decide
  | succ => exact successorCode_pos _
  | limit e => exact lt_of_lt_of_le (by decide : 0 < 3) (limitCode_ge_three e)

theorem edge_iff (a b : ℕ) : Edge a b ↔
    (0 < a ∧ b = successorCode a) ∨ ∃ e n, b = limitCode e ∧ Runs e n a := by
  constructor
  · intro h
    cases h with
    | succ a ha => exact Or.inl ⟨ha,rfl⟩
    | limit e n a h => exact Or.inr ⟨e,n,rfl,h⟩
  · rintro (⟨ha,rfl⟩ | ⟨e,n,rfl,h⟩)
    · exact .succ a ha
    · exact .limit e n a h

theorem not_edge_zero (a : ℕ) : ¬ Edge a 1 := by
  rw [edge_iff]
  rintro (⟨ha,he⟩ | ⟨e,n,he,_⟩)
  · have hz : successorCode a = successorCode 0 := he.symm
    have := successorCode_injective hz
    omega
  · have := limitCode_ge_three e
    omega

theorem edge_successor_iff (a b : ℕ) (hb : 0 < b) :
    Edge a (successorCode b) ↔ a = b := by
  rw [edge_iff]
  constructor
  · rintro (⟨_,he⟩ | ⟨e,n,he,_⟩)
    · exact (successorCode_injective he).symm
    · exact (successorCode_ne_limitCode b e he).elim
  · rintro rfl
    exact Or.inl ⟨hb,rfl⟩

theorem edge_limit_iff (e : ℕ) (f : ℕ → ℕ)
    (hc : NumericalComputes (Term.closedProgram e) f) (a : ℕ) :
    Edge a (limitCode e) ↔ ∃ n, a = f n := by
  rw [edge_iff]
  constructor
  · rintro (⟨_,he⟩ | ⟨e',n,he,hr⟩)
    · exact (successorCode_ne_limitCode a e he.symm).elim
    · have he' : e = e' := limitCode_injective he
      subst e'
      exact ⟨n,runs_unique hr (hc.2 n)⟩
  · rintro ⟨n,rfl⟩
    exact Or.inr ⟨e,n,rfl,hc.2 n⟩

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: proof
  excerpt: |
    \begin{proof}[Proof]
    The three possible forms are disjoint: $1$ has no candidate predecessor, a power $2^a$ with positive exponent is even, and
    $3\cdot5^e$ is odd and at least three. Both coding functions are injective. Consequently the only candidate
    predecessor of $2^a$, for $a>0$, is $a$. If $\varphi_e$ is total, the candidate predecessors of $3\cdot5^e$
    are exactly its values, by uniqueness of numerical output. Induction on the generation of a valid notation now
    shows both that every candidate predecessor is valid and that all such predecessors are accessible. This proves
    well-foundedness below the notation. Applying predecessor validity along a finite chain proves downward closure
    and the displayed equivalence.
-/
theorem Valid.acc {a : ℕ} (h : Valid a) : Acc Edge a := by
  induction h with
  | zero => exact Acc.intro _ (fun b hb => (not_edge_zero b hb).elim)
  | @succ a ha ih =>
    constructor
    intro b hb
    obtain rfl := (edge_successor_iff b a ha.pos).mp hb
    exact ih
  | limit e f hc hf hi ih =>
    constructor
    intro b hb
    obtain ⟨n,rfl⟩ := (edge_limit_iff e f hc b).mp hb
    exact ih n

theorem Valid.edge_down {a b : ℕ} (hb : Valid b) (h : Edge a b) : Valid a := by
  cases hb with
  | zero => exact (not_edge_zero a h).elim
  | @succ b hb =>
    obtain rfl := (edge_successor_iff a b hb.pos).mp h
    exact hb
  | limit e f hc hf hi =>
    obtain ⟨n,rfl⟩ := (edge_limit_iff e f hc a).mp h
    exact hf n

theorem Valid.down {a b : ℕ} (hb : Valid b) (h : RawPrecedes a b) : Valid a := by
  induction h with
  | single h => exact hb.edge_down h
  | tail h he ih => exact ih (hb.edge_down he)

/-- Edges generated by valid zero/successor/limit rules. -/
inductive GeneratingStep : ℕ → ℕ → Prop
  | succ (a : ℕ) (ha : Valid a) : GeneratingStep a (successorCode a)
  | limit (e n a : ℕ) (he : Valid (limitCode e)) (h : Runs e n a) :
      GeneratingStep a (limitCode e)

abbrev Precedes := Relation.TransGen GeneratingStep

theorem generatingStep_iff (a b : ℕ) : GeneratingStep a b ↔ Edge a b ∧ Valid b := by
  constructor
  · intro h
    cases h with
    | succ a ha => exact ⟨.succ a ha.pos,.succ ha⟩
    | limit e n a he h => exact ⟨.limit e n a h,he⟩
  · rintro ⟨h,hb⟩
    cases h with
    | succ a ha => exact .succ a (hb.edge_down (.succ a ha))
    | limit e n a h => exact .limit e n a hb h

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: statement
  kind: proposition
  title: Generation of Kleene notations
-/
theorem precedes_iff (a b : ℕ) : Precedes a b ↔ RawPrecedes a b ∧ Valid b := by
  constructor
  · intro h
    induction h with
    | single h =>
      have hh := (generatingStep_iff _ _).mp h
      exact ⟨.single hh.1,hh.2⟩
    | tail h he ih =>
      have hh := (generatingStep_iff _ _).mp he
      exact ⟨.tail ih.1 hh.1,hh.2⟩
  · rintro ⟨h,hb⟩
    induction h with
    | single h => exact .single ((generatingStep_iff _ _).mpr ⟨h,hb⟩)
    | tail h he ih => exact .tail (ih (hb.edge_down he)) ((generatingStep_iff _ _).mpr ⟨he,hb⟩)

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: prose
  excerpt: |
    The simultaneous rules in the proposition adjoin $1$; they adjoin $2^a$ and declare
    $\KleenePrecedes{a}{2^a}$ whenever $a\in\KleeneO$; and they adjoin $3\cdot5^e$ and declare
    $\KleenePrecedes{\varphi_e(n)}{3\cdot5^e}$ for every $n$ whenever the sequence is total, takes values in
    $\KleeneO$, and is increasing in precedence. The relation is also required to be transitive.
-/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: prose
  excerpt: |
    Increase of the represented ordinals alone is not the defining condition for a permitted limit sequence;
    the comparisons must hold in the generated precedence relation.
-/
theorem valid_limit (e : ℕ) (f : ℕ → ℕ) (hc : NumericalComputes (Term.closedProgram e) f)
    (hf : ∀ n, Valid (f n)) (hi : ∀ n, Precedes (f n) (f (n+1))) : Valid (limitCode e) :=
  .limit e f hc hf (fun n => ((precedes_iff _ _).mp (hi n)).1)

theorem rawPrecedes_last {a b : ℕ} (h : RawPrecedes a b) :
    ∃ c, Edge c b ∧ (a = c ∨ RawPrecedes a c) := by
  cases h with
  | single h => exact ⟨a,h,Or.inl rfl⟩
  | tail h he => exact ⟨_,he,Or.inr h⟩

/-- The simultaneous rules determine the least pair of validity and precedence predicates. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: proof
  excerpt: |
    The equivalence shows that the constructed pair satisfies the simultaneous rules. To prove minimality, let
    $C$ and $R$ be any other set and transitive relation satisfying those rules. Induct on the generation of
    $b\in\KleeneO$, proving together that $b\in C$ and that every $a$ with $\KleeneCandidatePrecedes{a}{b}$
    belongs to $C$ and satisfies $R(a,b)$. The zero case has no predecessors. In the successor case, the last step
    of any candidate chain enters from the preceding notation; apply the induction hypothesis and then the
    successor rule for $R$. In the limit case, the induction hypotheses at consecutive sequence values turn their
    candidate comparison into an $R$ comparison. The limit rules therefore apply. The last step of any chain into
    the limit comes from one sequence value; its induction hypothesis and transitivity of $R$ finish the proof.
    \end{proof}
-/
theorem least_rules (C : ℕ → Prop) (R : ℕ → ℕ → Prop)
    (hz : C 1)
    (hs : ∀ a, C a → C (successorCode a))
    (hl : ∀ e f, NumericalComputes (Term.closedProgram e) f →
      (∀ n, C (f n)) → (∀ n, R (f n) (f (n+1))) → C (limitCode e))
    (rs : ∀ a, C a → R a (successorCode a))
    (rl : ∀ e f, NumericalComputes (Term.closedProgram e) f →
      (∀ n, C (f n)) → (∀ n, R (f n) (f (n+1))) → ∀ n, R (f n) (limitCode e))
    (rt : ∀ {a b c}, R a b → R b c → R a c) :
    (∀ a, Valid a → C a) ∧ (∀ a b, Precedes a b → R a b) := by
  have main : ∀ a, Valid a → C a ∧ ∀ b, RawPrecedes b a → C b ∧ R b a := by
    intro a ha
    induction ha with
    | zero =>
      refine ⟨hz, ?_⟩
      intro b hb
      obtain ⟨c, hc, _⟩ := rawPrecedes_last hb
      exact (not_edge_zero c hc).elim
    | @succ a ha ih =>
      refine ⟨hs a ih.1, ?_⟩
      intro b hb
      obtain ⟨c, hc, hbc⟩ := rawPrecedes_last hb
      have heq : c = a := (edge_successor_iff c a ha.pos).mp hc
      subst c
      rcases hbc with rfl | hba
      · exact ⟨ih.1, rs _ ih.1⟩
      · exact ⟨(ih.2 b hba).1, rt (ih.2 b hba).2 (rs _ ih.1)⟩
    | limit e f hc hf hi ih =>
      have cf : ∀ n, C (f n) := fun n => (ih n).1
      have rf : ∀ n, R (f n) (f (n+1)) := fun n => ((ih (n+1)).2 _ (hi n)).2
      refine ⟨hl e f hc cf rf, ?_⟩
      intro b hb
      obtain ⟨c, he, hbc⟩ := rawPrecedes_last hb
      obtain ⟨n, rfl⟩ := (edge_limit_iff e f hc c).mp he
      rcases hbc with rfl | hbn
      · exact ⟨cf n, rl e f hc cf rf n⟩
      · exact ⟨((ih n).2 b hbn).1, rt ((ih n).2 b hbn).2 (rl e f hc cf rf n)⟩
  exact ⟨fun a ha => (main a ha).1, fun a b h =>
    ((main b ((precedes_iff a b).mp h).2).2 a ((precedes_iff a b).mp h).1).2⟩

/-- The ordinal represented by a valid notation. -/
noncomputable def value (a : ℕ) (ha : Valid a) : Ordinal := ha.acc.rank

theorem value_lt_of_edge {a b : ℕ} (ha : Valid a) (hb : Valid b) (h : Edge a b) :
    value a ha < value b hb := hb.acc.rank_lt_of_rel h

theorem value_lt {a b : ℕ} (ha : Valid a) (hb : Valid b) (h : RawPrecedes a b) :
    value a ha < value b hb := by
  induction h with
  | single h => exact value_lt_of_edge ha hb h
  | tail h he ih => exact (ih (hb.edge_down he)).trans (value_lt_of_edge _ hb he)

theorem value_zero : value 1 .zero = 0 := by
  rw [value, Acc.rank_eq]
  apply le_antisymm _ zero_le
  apply Ordinal.iSup_le
  intro b
  exact (not_edge_zero b.val b.property).elim

theorem value_successor (a : ℕ) (ha : Valid a) :
    value (successorCode a) (.succ ha) = Order.succ (value a ha) := by
  apply le_antisymm
  · rw [value, Acc.rank_eq]
    apply Ordinal.iSup_le
    intro b
    obtain he := (edge_successor_iff b.val a ha.pos).mp b.property
    rcases b with ⟨b,hb⟩
    dsimp at he
    subst b
    exact le_rfl
  · exact Order.succ_le_of_lt (value_lt_of_edge ha (.succ ha) (.succ a ha.pos))

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: proof
  excerpt: |
    \begin{proof}[Proof]
    Assign to a valid notation its rank for the candidate relation, namely the supremum of the successors of the
    ranks of its immediate predecessors. The preceding proposition makes this recursion legitimate. Ranks strictly
    increase along candidate steps and hence along finite chains. The descriptions of the predecessors give zero
    at $1$ and the successor value at $2^a$. At a permitted limit, the rank is
    $\sup_n(\KleeneValue{\varphi_e(n)}+1)$. Consecutive values strictly increase, so each summand is at most
    $\KleeneValue{\varphi_e(n+1)}$; conversely each value is at most its successor. Thus this supremum equals
    $\sup_n\KleeneValue{\varphi_e(n)}$. Uniqueness follows by induction on the same generation rules.
-/
theorem value_limit (e : ℕ) (f : ℕ → ℕ)
    (hc : NumericalComputes (Term.closedProgram e) f)
    (hf : ∀ n, Valid (f n)) (hi : ∀ n, RawPrecedes (f n) (f (n+1))) :
    value (limitCode e) (.limit e f hc hf hi) = ⨆ n, value (f n) (hf n) := by
  apply le_antisymm
  · rw [value, Acc.rank_eq]
    apply Ordinal.iSup_le
    intro b
    obtain ⟨n, he⟩ := (edge_limit_iff e f hc b.val).mp b.property
    rcases b with ⟨b,hb⟩
    dsimp at he
    subst b
    exact (Order.succ_le_of_lt (value_lt (hf n) (hf (n+1)) (hi n))).trans
      (Ordinal.le_iSup _ (n+1))
  · apply Ordinal.iSup_le
    intro n
    exact (value_lt_of_edge (hf n) (.limit e f hc hf hi) (.limit e n (f n) (hc.2 n))).le

theorem precedes_value_lt {a b : ℕ} (h : Precedes a b) :
    ∃ (ha : Valid a) (hb : Valid b), value a ha < value b hb := by
  obtain ⟨hr,hb⟩ := (precedes_iff a b).mp h
  exact ⟨hb.down hr,hb,value_lt _ _ hr⟩

theorem precedes_irrefl (a : ℕ) : ¬ Precedes a a := by
  intro h
  obtain ⟨ha,hb,hlt⟩ := precedes_value_lt h
  exact (lt_irrefl (value a ha)) hlt

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: proof
  excerpt: |
    For countability, well-founded induction shows that every ordinal below an accessible number's rank is itself
    the rank of an accessible number: choose a predecessor whose rank dominates the desired ordinal and continue
    unless equality already holds. There are only countably many numbers, so every such rank is countable.
    \end{proof}
-/
theorem value_countable (a : ℕ) (ha : Valid a) : value a ha < Ordinal.omega 1 := by
  have hc : (Set.Iio (value a ha)).Countable := by
    apply (Set.countable_range (fun b : {n : ℕ // Acc Edge n} => b.property.rank)).mono
    intro β hβ
    obtain ⟨b,hb,he⟩ := Acc.mem_range_rank_of_le ha.acc hβ.le
    exact ⟨⟨b,hb⟩,he⟩
  have hk := Cardinal.le_aleph0_iff_set_countable.mpr hc
  rw [Cardinal.mk_Iio_ordinal] at hk
  have hcard : (value a ha).card ≤ Cardinal.aleph0 := by
    have hk' : Cardinal.lift.{1} (value a ha).card ≤
        Cardinal.lift.{1} (Cardinal.aleph0.{0}) := by
      simpa only [Cardinal.lift_aleph0] using hk
    exact Cardinal.lift_le.mp hk'
  exact Cardinal.lt_omega_iff_card_lt.mpr (Cardinal.lt_aleph_one_iff.mpr hcard)

/-- Every smaller ordinal occurs at a predecessor of the given notation. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: proof
  excerpt: |
    \begin{proof}[Proof]
    The reverse implication follows from strict increase of values along precedence. For the forward implication, induct
    on the generation of $b$. There is no ordinal below the value zero at $1$. If $b=2^c$, then
    $\alpha\le\KleeneValue{c}$. In the equality case take $a=c$; in the strict case use the induction hypothesis below $c$
    and append the successor step. If $b=3\cdot5^e$, the limit formula gives some $n$ with
    $\alpha<\KleeneValue{\varphi_e(n)}$. Use the induction hypothesis there and append the limit step. All notations and
    comparisons obtained this way are valid by the generation rules.
    \end{proof}
-/
theorem value_downward {b : ℕ} (hb : Valid b) {α : Ordinal} (hα : α < value b hb) :
    ∃ (a : ℕ) (ha : Valid a), RawPrecedes a b ∧ value a ha = α := by
  induction hb with
  | zero => rw [value_zero] at hα; exact (not_lt_of_ge zero_le hα).elim
  | @succ b hb ih =>
    rw [value_successor b hb, Order.lt_succ_iff] at hα
    rcases hα.eq_or_lt with he | hl
    · exact ⟨b,hb,.single (.succ b hb.pos),he.symm⟩
    · obtain ⟨a,ha,hab,hv⟩ := ih hl
      exact ⟨a,ha,.tail hab (.succ b hb.pos),hv⟩
  | limit e f hc hf hi ih =>
    rw [value_limit e f hc hf hi, Ordinal.lt_iSup_iff] at hα
    obtain ⟨n,hn⟩ := hα
    obtain ⟨a,ha,han,hv⟩ := ih n hn
    exact ⟨a,ha,.tail han (.limit e n (f n) (hc.2 n)),hv⟩

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: statement
  kind: proposition
  title: Smaller ordinals below a notation
-/
theorem value_downward_iff {b : ℕ} (hb : Valid b) (α : Ordinal) :
    α < value b hb ↔ ∃ (a : ℕ) (ha : Valid a), Precedes a b ∧ value a ha = α := by
  constructor
  · intro h
    obtain ⟨a,ha,hab,hv⟩ := value_downward hb h
    exact ⟨a,ha,(precedes_iff a b).mpr ⟨hab,hb⟩,hv⟩
  · rintro ⟨a,ha,hab,rfl⟩
    exact value_lt ha hb ((precedes_iff a b).mp hab).1

/-- The three interpretation equations uniquely determine the represented ordinal. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  target: statement
  kind: proposition
  title: Ordinal interpretation of Kleene notations
-/
theorem value_unique (v : ∀ a, Valid a → Ordinal)
    (hz : v 1 .zero = 0)
    (hs : ∀ a ha, v (successorCode a) (.succ ha) = Order.succ (v a ha))
    (hl : ∀ e f hc hf hi, v (limitCode e) (.limit e f hc hf hi) = ⨆ n, v (f n) (hf n))
    (a : ℕ) (ha : Valid a) : v a ha = value a ha := by
  induction ha with
  | zero => exact hz.trans value_zero.symm
  | succ ha ih => rw [hs _ ha, value_successor _ ha, ih]
  | limit e f hc hf hi ih =>
    rw [hl e f hc hf hi, value_limit e f hc hf hi]
    exact congrArg (fun g : ℕ → Ordinal => ⨆ n, g n) (funext ih)

end KleeneNotation
end PolishSpaceBook
