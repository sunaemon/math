module

public import PolishSpaceBook.FirstOrderNamedFreeVariables

@[expose] public section

/-!
# Alpha-equivalence generated by renaming first-order binders

The relation is the smallest equivalence closed under formula contexts and fresh
binder renaming. It is not defined by equality of interpretations.
-/

namespace PolishSpaceBook.NamedFirstOrder
open FirstOrder Language
universe u v w
variable {L : Language.{u,v}} {M : Type w} [L.Structure M]

namespace Formula

/-- Finite derivations from exactly the appendix's alpha-equivalence rules. -/
/-@ booklink:
  source: polish-space-book/appendix-logic.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    **$\alpha$-equivalence.** The choice of bound-variable name is a syntactic accident: $\forall x\, (x = x)$ and $\forall
    y\, (y = y)$ express the same proposition. We define \termdefineas{alpha-equivalence}{$\alpha$-equivalence}
    $\equiv_\alpha$ on formulas as the smallest equivalence relation such that
    $$\forall y\, \varphi \;\equiv_\alpha\; \forall z\, (\varphi\subst{y}{z}), \qquad \exists y\, \varphi \;\equiv_\alpha\;
    \exists z\, (\varphi\subst{y}{z})$$
    whenever $z \notin \FreeVars{\varphi}$, and which is a congruence with respect to all formula constructors. Atomic
    formulas are $\alpha$-equivalent only to themselves, and $\varphi \star \psi \equiv_\alpha \varphi' \star \psi'$
    whenever $\varphi \equiv_\alpha \varphi'$ and $\psi \equiv_\alpha \psi'$.
    Quantifiers obey the corresponding congruence rule.
-/
inductive Alpha : Formula L → Formula L → Prop where
  | refl (φ : Formula L) : Alpha φ φ
  | symm {φ ψ : Formula L} : Alpha φ ψ → Alpha ψ φ
  | trans {φ ψ χ : Formula L} : Alpha φ ψ → Alpha ψ χ → Alpha φ χ
  | binary (c : Connective) {φ φ' ψ ψ' : Formula L} :
      Alpha φ φ' → Alpha ψ ψ' → Alpha (binary c φ ψ) (binary c φ' ψ')
  | quant (q : Quantifier) (x : ℕ) {φ ψ : Formula L} :
      Alpha φ ψ → Alpha (quant q x φ) (quant q x ψ)
  | rename (q : Quantifier) (φ : Formula L) (x z : ℕ) :
      z ∉ φ.fv → Alpha (quant q x φ) (quant q z (φ.subst x (.var z)))

theorem Alpha.nodes_eq {φ ψ : Formula L} (h : Alpha φ ψ) : φ.nodes = ψ.nodes := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | binary c _ _ ih₁ ih₂ => simp only [nodes, ih₁, ih₂]
  | quant q x _ ih => simp only [nodes, ih]
  | rename q φ x z hz => simp only [nodes, nodes_subst]

/-@ booklink:
  source: polish-space-book/appendix-logic.md
  target: statement
  kind: lemma
  title: Free variables and binder renaming
-/
/-@ booklink:
  source: polish-space-book/appendix-logic.md
  target: proof
  excerpt: |
    For the first assertion, induct on a derivation of $\alpha$-equivalence. The equivalence and congruence rules preserve
    the equality of free-variable sets. For a generating renaming, the preceding lemma and $z\notin\FreeVars{\varphi}$ give
    $$\FreeVars{\forallbind{z}{(\varphi\subst{y}{z})}}
    =\SetDifference{\FreeVars{\varphi}}{\{y\}}
    =\FreeVars{\forallbind{y}{\varphi}},$$
    and the existential case is identical.
-/
theorem Alpha.fv_eq {φ ψ : Formula L} (h : Alpha φ ψ) : φ.fv = ψ.fv := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | binary c _ _ ih₁ ih₂ => simp only [fv, ih₁, ih₂]
  | quant q x _ ih => simp only [fv, ih]
  | rename q φ x z hz =>
    ext v
    simp only [fv, Finset.mem_erase, mem_fv_subst, Term.varFinset, Finset.mem_singleton]
    by_cases hvz : v = z
    · subst v; simp [hz]
    · tauto

/-@ booklink:
  source: polish-space-book/appendix-logic.md
  target: proof
  excerpt: |
    \begin{proof}
    Induct on a derivation of $\alpha$-equivalence. Equivalence rules preserve logical equivalence, and congruence follows
    from the semantic clauses. For a generating renaming with $z\notin\FreeVars{\varphi}$, the substitution lemma gives,
    for each $a\in M$,
    $$\mathcal M,s[z\mapsto a]\models\varphi\subst{y}{z}
    \quad\Longleftrightarrow\quad
    \mathcal M,s[z\mapsto a][y\mapsto a]\models\varphi.$$
    The assignment locality lemma removes the update at $z$, leaving $\mathcal M,s[y\mapsto a]\models\varphi$.
    Quantifying over $a$ proves the universal and existential renaming cases.
    \end{proof}
-/
/-@ booklink:
  source: polish-space-book/appendix-logic.md
  target: statement
  excerpt: |
    \begin{corollary*}[$\alpha$-equivalence preserves truth]
-/
theorem Alpha.realize {φ ψ : Formula L} (h : Alpha φ ψ) (s : ℕ → M) :
    φ.Realize s ↔ ψ.Realize s := by
  induction h generalizing s with
  | refl => rfl
  | symm _ ih => exact (ih s).symm
  | trans _ _ ih₁ ih₂ => exact (ih₁ s).trans (ih₂ s)
  | binary c _ _ ih₁ ih₂ => exact c.eval_congr (ih₁ s) (ih₂ s)
  | quant q x _ ih => exact q.eval_congr (fun a => ih (Function.update s x a))
  | rename q φ x z hz => exact (realize_rename_quant q x z φ hz s).symm

/-- An absent-variable substitution can still rename binders, but nothing else. -/
/-@ booklink:
  source: polish-space-book/appendix-logic.md
  target: statement
  kind: lemma
  title: Free variables and binder renaming
-/
/-@ booklink:
  source: polish-space-book/appendix-logic.md
  target: proof
  excerpt: |
    For the second assertion, use strong induction on the number of formula constructors. Terms with no occurrence of $x$
    are unchanged, which settles the atomic cases; the Boolean cases follow by congruence. Under a quantifier binding $x$,
    substitution stops. Under a different binder $y$, the body still has no free occurrence of $x$.
    If no renaming is needed, apply the induction hypothesis to the body.
    Otherwise the rule renames $y$ to a fresh $z\ne x$. The preceding lemma
    shows that $x$ remains absent from the renamed body, so the induction hypothesis removes the subsequent substitution
    up to $\alpha$-equivalence. The remaining formula is a generating renaming of the original quantified formula.
-/
theorem alpha_subst_not_free (φ : Formula L) (x : ℕ) (t : L.Term ℕ) (hx : x ∉ φ.fv) :
    Alpha (φ.subst x t) φ := by
  have bounded : ∀ k (φ : Formula L), φ.nodes ≤ k → x ∉ φ.fv →
      Alpha (φ.subst x t) φ := by
    intro k
    induction k with
    | zero => intro φ hk; have := φ.nodes_pos; omega
    | succ k ih =>
      intro φ hk hx
      cases φ with
      | falsum => exact .refl _
      | equal a b =>
        have hab : x ∉ a.varFinset ∧ x ∉ b.varFinset := by simpa [fv] using hx
        rw [subst_equal, termSubst_not_free a x t hab.1, termSubst_not_free b x t hab.2]
        exact .refl _
      | rel R ts =>
        have ht (i) : termSubst (ts i) x t = ts i := by
          apply termSubst_not_free
          intro hi
          exact hx (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hi⟩)
        rw [subst_rel]
        simp only [ht]
        exact .refl _
      | binary c φ ψ =>
        have hφ : φ.nodes ≤ k := by simp only [nodes] at hk; omega
        have hψ : ψ.nodes ≤ k := by simp only [nodes] at hk; omega
        have hf : x ∉ φ.fv ∧ x ∉ ψ.fv := by simpa only [fv, Finset.mem_union, not_or] using hx
        rw [subst_binary]
        exact .binary c (ih φ hφ hf.1) (ih ψ hψ hf.2)
      | quant q y φ =>
        have hφ : φ.nodes ≤ k := by simpa only [nodes, Nat.add_le_add_iff_right] using hk
        rw [subst_quant]
        by_cases hy : y = x
        · rw [ite_eq_left hy]; exact .refl _
        · rw [ite_eq_right hy]
          have hφx : x ∉ φ.fv := by
            simpa only [fv, Finset.mem_erase, ne_eq, Ne.symm hy, not_false_eq_true, true_and] using hx
          by_cases ht : y ∉ t.varFinset
          · rw [ite_eq_left ht]; exact .quant q y (ih φ hφ hφx)
          · rw [ite_eq_right ht]
            let z := NamedLambda.Term.fresh (φ.fv ∪ t.varFinset ∪ {x})
            have hz : z ∉ φ.fv ∧ z ∉ t.varFinset ∧ z ≠ x := by
              simpa only [z, Finset.mem_union, Finset.mem_singleton, not_or, and_assoc]
                using NamedLambda.Term.fresh_not_mem (φ.fv ∪ t.varFinset ∪ {x})
            have hr : x ∉ (φ.subst y (.var z)).fv := by
              simp only [mem_fv_subst, Term.varFinset, Finset.mem_singleton,
                hφx, false_and, false_or]
              exact fun h => hz.2.2 h.2.symm
            exact (Alpha.quant q z (ih (φ.subst y (.var z))
              (by simpa only [nodes_subst] using hφ) hr)).trans
                (.symm (.rename q φ y z hz.1))
  exact bounded φ.nodes φ le_rfl hx

end Formula
end PolishSpaceBook.NamedFirstOrder
