module

public import PolishSpaceBook.AssemblyCoproducts
public import Mathlib.CategoryTheory.Limits.Constructions.LimitsOfProductsAndEqualizers

@[expose] public section

/-! # Coequalizers and finite colimits of assemblies

A quotient name is any name of any representative. Descent uses the original
tracker; no algorithm for choosing or comparing representatives is assumed.
-/
namespace PolishSpaceBook.Assembly
open CategoryTheory CategoryTheory.Limits
universe u v
variable {A : Type u} {K : PartialCombinatoryAlgebra A}
variable {X Y : Assembly.{u,v} K}

def generatingRelation (f g : X ⟶ Y) (y z : Y.Carrier) : Prop := ∃ x, f x = y ∧ g x = z

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: proof
  excerpt: |
    For parallel morphisms $f,g:X\to Y$, let $E$ be the equivalence relation on $|Y|$ generated by the pairs
    $(f(x),g(x))$, and put $Q:=\SetQuotient{|Y|}{E}$. Define
    $$a\Vdash_Q\EquivalenceClass{E}{y}
    \quad\Longleftrightarrow\quad
    \exists z\in|Y|\,\bigl((z,y)\in E\land a\Vdash_Y z\bigr).$$
    This is independent of the representative and gives a nonempty realizer set to every class. The quotient map
    is tracked by the identity combinator and equalizes the two given morphisms.
-/
def coequalizerObject (f g : X ⟶ Y) : Assembly.{u,v} K where
  Carrier := Quot (generatingRelation f g)
  realizes a z := ∃ y, Quot.mk (generatingRelation f g) y = z ∧ Y.realizes a y
  inhabited z := Quot.inductionOn z (fun y => by
    obtain ⟨a,ha⟩ := Y.inhabited y
    exact ⟨a,y,rfl,ha⟩)

def coequalizerProjection (f g : X ⟶ Y) : Y ⟶ coequalizerObject f g where
  toFun := Quot.mk (generatingRelation f g)
  tracked := ⟨K.identity,fun y a ha => ⟨a,K.application_identity a,y,rfl,ha⟩⟩

def coequalizerDesc (f g : X ⟶ Y) (s : Cofork f g) : coequalizerObject f g ⟶ s.pt where
  toFun := Quot.lift s.π (by
    rintro y z ⟨x,rfl,rfl⟩
    exact congrArg (fun q : X ⟶ s.pt => q x) s.condition)
  tracked := by
    obtain ⟨r,hr⟩ := s.π.tracked
    refine ⟨r,?_⟩
    rintro z a ⟨y,rfl,hy⟩
    exact hr y a hy

def coequalizerCofork (f g : X ⟶ Y) : Cofork f g :=
  Cofork.ofπ (coequalizerProjection f g) (Hom.ext (fun x => Quot.sound ⟨x,rfl,rfl⟩))

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: proof
  excerpt: |
    If a morphism $h:Y\to Z$ equalizes them, its underlying function is constant on the generating pairs, hence on
    all equivalence classes, and so it induces a unique function on the quotient. Any tracker of the original
    morphism tracks this induced function. Indeed, a realizer of a class realizes some representative, and the
    original tracker sends it to a realizer of that representative's image, which is the required class image.
    The computation takes only the input realizer; it does not choose a representative or decide equivalence of
    representatives. This proves the coequalizer property. Initial objects, binary coproducts, and coequalizers give
    all finite colimits by the standard finite-colimit construction.
-/
def coequalizerIsColimit (f g : X ⟶ Y) : IsColimit (coequalizerCofork f g) :=
  Cofork.IsColimit.mk _ (coequalizerDesc f g) (fun _ => Hom.ext (fun _ => rfl)) (by
    intro s m h
    apply Hom.ext
    intro z
    refine Quot.inductionOn z (fun y => ?_)
    exact congrArg (fun q : Y ⟶ s.pt => q y) h)

instance assemblyHasColimitParallelPair (f g : X ⟶ Y) : HasColimit (parallelPair f g) :=
  HasColimit.mk ⟨_,coequalizerIsColimit f g⟩

instance assemblyHasCoequalizers : HasCoequalizers (Assembly.{u,v} K) :=
  hasCoequalizers_of_hasColimit_parallelPair _

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: statement
  kind: proposition
  title: Finite colimits of assemblies
-/
instance assemblyHasFiniteColimits : HasFiniteColimits (Assembly.{u,v} K) :=
  hasFiniteColimits_of_hasCoequalizers_and_finite_coproducts

end PolishSpaceBook.Assembly
