module

public import PolishSpaceBook.PolishGroups
public import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected

@[expose] public section

/-! # Local orbits as graph components

The graph lives on the actual open set U, so every endpoint stays in U.
Inversion closure of V is exactly what makes the move graph undirected.
-/
namespace PolishSpaceBook
open Set
variable {G X : Type*} [Group G] [MulAction G X]


/-- A finite legal sequence of moves stays in the global orbit. -/
lemma localOrbit_subset_global (x : X) (U : Set X) (V : Set G) :
    localOrbit x U V ⊆ MulAction.orbit G x := by
  intro y hy
  induction hy with
  | base => exact MulAction.mem_orbit_self x
  | @step z hz g hg hgz ih =>
    obtain ⟨h, hh⟩ := MulAction.mem_orbit_iff.mp ih
    exact MulAction.mem_orbit_iff.mpr ⟨g * h, by rw [mul_smul, hh]⟩

/-- Enlarging either permitted set only enlarges the local orbit. -/
lemma localOrbit_mono (x : X) {U U' : Set X} {V V' : Set G}
    (hU : U ⊆ U') (hV : V ⊆ V') : localOrbit x U V ⊆ localOrbit x U' V' :=
  localOrbit_minimal (mem_localOrbit x U' V')
    (fun _ hy g hg hgy => smul_mem_localOrbit hy g (hV hg) (hU hgy))

/-- With every move and every point permitted, one step already reaches the
entire orbit. -/
lemma localOrbit_univ (x : X) :
    localOrbit x (univ : Set X) (univ : Set G) = MulAction.orbit G x := by
  apply Subset.antisymm (localOrbit_subset_global x univ univ)
  intro y hy
  obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hy
  exact smul_mem_localOrbit (mem_localOrbit x univ univ) g (mem_univ _) (mem_univ _)

/-@ booklink:
  source: polish-space-book/polish-groups.md
  target: prose
  excerpt: |
    Local orbits sit between the singleton $\{x\}$ and the full orbit $G\cdot x\cap U$,
-/
/-- The local orbit contains its starting point and lies in both U and the
full group orbit, exactly as in the book. -/
theorem localOrbit_bounds (x : X) (U : Set X) (V : Set G) (hx : x ∈ U) :
    x ∈ localOrbit x U V ∧ localOrbit x U V ⊆ MulAction.orbit G x ∩ U :=
  ⟨mem_localOrbit x U V, fun _ hy =>
    ⟨localOrbit_subset_global x U V hy, localOrbit_subset hx hy⟩⟩

/-@ booklink:
  source: polish-space-book/polish-groups.md
  target: prose
  excerpt: |
    and they refine to the orbit as $U \uparrow X$ and $V \uparrow G$.
-/
/-- Any increasing exhaustive families of permitted regions and moves exhaust
the global orbit. Every target point is reached by one move at a late enough stage. -/
theorem iUnion_localOrbit_eq_orbit (x : X) (U : ℕ → Set X) (V : ℕ → Set G)
    (hU : Monotone U) (hV : Monotone V)
    (hUX : ⋃ n, U n = univ) (hVG : ⋃ n, V n = univ) :
    (⋃ n, localOrbit x (U n) (V n)) = MulAction.orbit G x := by
  apply Subset.antisymm
  · exact iUnion_subset fun n => localOrbit_subset_global x (U n) (V n)
  · intro y hy
    obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hy
    obtain ⟨i, hi⟩ := mem_iUnion.mp (show g • x ∈ ⋃ n, U n by rw [hUX]; trivial)
    obtain ⟨j, hj⟩ := mem_iUnion.mp (show g ∈ ⋃ n, V n by rw [hVG]; trivial)
    refine mem_iUnion.mpr ⟨max i j, ?_⟩
    exact smul_mem_localOrbit (mem_localOrbit x (U (max i j)) (V (max i j))) g
      (hV (le_max_right i j) hj) (hU (le_max_left i j) hi)

/-- Remove loops from the elementary move relation to obtain the canonical
simple graph. Inverse moves give its symmetry. -/
def localMoveGraph (U : Set X) (V : Set G) (hV : ∀ g ∈ V, g⁻¹ ∈ V) : SimpleGraph U where
  Adj y z := y ≠ z ∧ ∃ g ∈ V, z.val = g • y.val
  symm := ⟨by
    rintro y z ⟨hne, g, hg, hz⟩
    refine ⟨hne.symm, g⁻¹, hV g hg, ?_⟩
    rw [hz]
    simp⟩
  loopless := ⟨by intro y h; exact h.1 rfl⟩

/-@ booklink:
  source: polish-space-book/polish-groups.md
  target: prose
  excerpt: |
    This is the directed reachability set generated by the moves $y\mapsto g\cdot y$ with $g\in V$. When $V$ is symmetric,
    it is equivalently the connected component of $x$ in the undirected graph on $U$ whose edges join $y$ to $g\cdot y$
    when both endpoints lie in $U$.
-/
/-- Directed finite reachability agrees with the graph component when V is
closed under inversion, including the zero-length path. -/
theorem localOrbit_iff_graph_reachable (x y : X) (U : Set X) (V : Set G)
    (hV : ∀ g ∈ V, g⁻¹ ∈ V) (hx : x ∈ U) (hy : y ∈ U) :
    y ∈ localOrbit x U V ↔ (localMoveGraph U V hV).Reachable ⟨x, hx⟩ ⟨y, hy⟩ := by
  let H := localMoveGraph U V hV
  constructor
  · intro h
    have hp : ∃ z : U, z.val = y ∧ H.Reachable ⟨x, hx⟩ z := by
      induction h with
      | base => exact ⟨⟨x, hx⟩, rfl, .refl _⟩
      | @step z hz g hg hgz ih =>
        obtain ⟨z', hz', hp⟩ := ih (localOrbit_subset hx hz)
        let t : U := ⟨g • z, hgz⟩
        by_cases he : z' = t
        · exact ⟨t, rfl, he ▸ hp⟩
        · refine ⟨t, rfl, hp.trans (SimpleGraph.Adj.reachable ?_)⟩
          exact ⟨he, g, hg, by dsimp [t]; rw [hz']⟩
    obtain ⟨z, hz, hp⟩ := hp
    have he : z = ⟨y, hy⟩ := Subtype.ext hz
    exact he ▸ hp
  · intro h
    have hr := (H.reachable_iff_reflTransGen _ _).mp h
    have helper : ∀ a b : U, Relation.ReflTransGen H.Adj a b →
        a.val ∈ localOrbit x U V → b.val ∈ localOrbit x U V := by
      intro a b hab
      induction hab with
      | refl => exact id
      | @tail b c hab hbc ih =>
        intro ha
        obtain ⟨_, g, hg, hc⟩ := hbc
        rw [hc]
        exact smul_mem_localOrbit (ih ha) g hg (hc ▸ c.property)
    exact helper _ _ hr (mem_localOrbit x U V)

end PolishSpaceBook
