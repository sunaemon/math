module

public import PolishSpaceBook.LambdaGHChoquetStrategy
public import PolishSpaceBook.StrongChoquetTransport

@[expose] public section

/-! # Relative and transported Gandy--Harrington spaces

The presentation topology is generated by the pullbacks of the actual
fixed-parameter pair-tree projections. Injective presentations with an
analytic range, and analytic subspaces in those presentations, inherit the
explicit winning strategy on Baire space.
-/
namespace PolishSpaceBook.LambdaTree.GHChoquet
open Set Topology TopologicalSpace

/-- Relative topology on a fixed-parameter analytic set. -/
abbrev relativeTopology (ε : ℕ → ℕ) (A : Set FusionReal) : TopologicalSpace A :=
  induced Subtype.val (parameterGHTopology ε)

/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: statement
  excerpt: |
    \begin{fact*}[about $\GHTopology$] The following facts hold.
-/
theorem projected_strongChoquet {ε : ℕ → ℕ} {A : Set FusionReal} (hA : Projected ε A) :
    @StrongChoquetGame.IsStrongChoquet A (relativeTopology ε A) := by
  let : TopologicalSpace FusionReal := parameterGHTopology ε
  exact (strongChoquet ε).open_subspace ((parameterGHBasis_isBasis ε).isOpen hA)

/-- The topology transported by a presentation into Baire space. -/
abbrev presentationTopology {X : Type*} (ε : ℕ → ℕ) (f : X → FusionReal) : TopologicalSpace X :=
  induced f (parameterGHTopology ε)

/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: proof
  excerpt: |
    Every $\lSigma^1_1(\varepsilon)$ set $A$ is open in $\GHTopology$. The transport lemma in
    §{sec:topological-infinite-games} therefore makes $A$ strong Choquet in the relative topology.
    For the chosen closed presentation $f:X\to C\IncludedIn\BaireSpace$, the topology on $X$ is generated
    by the preimages $f^{-1}[B]$ of the fixed-parameter analytic sets $B$. This is exactly the topology
    induced by $f$ from the ambient Gandy--Harrington topology. If $A\IncludedIn X$ is analytic in this
    presentation, then $f[A]$ is a fixed-parameter analytic set, and $f$ restricts to a homeomorphism from
    $A$ onto $f[A]$ with their relative topologies. Transporting the strategy once more proves (2) on $X$.
    \end{proof}
-/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    Fix a real parameter $\varepsilon$ coding
    this presentation of $X$ and its countable base. The
    \termdefine{Gandy--Harrington topology} $\GHTopology$ on $X$ is generated by the lightface
    $\lSigma^1_1(\varepsilon)$ subsets of $X$.
-/
theorem presentationTopology_eq {X : Type*} (ε : ℕ → ℕ) (f : X → FusionReal) :
    presentationTopology ε f = generateFrom {U | ∃ B, Projected ε B ∧ U = f ⁻¹' B} := by
  let : TopologicalSpace FusionReal := parameterGHTopology ε
  rw [presentationTopology, (parameterGHBasis_isBasis ε).eq_generateFrom, induced_generateFrom_eq]
  congr 1
  ext U
  simp only [mem_image, parameterGHBasis, mem_ofPred_eq]
  constructor
  · rintro ⟨B, hB, rfl⟩; exact ⟨B, hB, rfl⟩
  · rintro ⟨B, hB, rfl⟩; exact ⟨B, hB, rfl⟩

theorem presentation_strongChoquet {X : Type*} {ε : ℕ → ℕ} {f : X → FusionReal}
    (hf : Function.Injective f) (hC : Projected ε (range f)) :
    @StrongChoquetGame.IsStrongChoquet X (presentationTopology ε f) := by
  let : TopologicalSpace FusionReal := parameterGHTopology ε
  let : TopologicalSpace X := presentationTopology ε f
  have he : IsOpenEmbedding f :=
    ⟨⟨⟨rfl⟩, hf⟩, (parameterGHBasis_isBasis ε).isOpen hC⟩
  exact (strongChoquet ε).of_openEmbedding he

/-- It is enough that the image of the subspace be analytic; the original
ambient presentation does not need to be surjective onto Baire space. -/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: proof
  excerpt: |
    Every $\lSigma^1_1(\varepsilon)$ set $A$ is open in $\GHTopology$. The transport lemma in
    §{sec:topological-infinite-games} therefore makes $A$ strong Choquet in the relative topology.
    For the chosen closed presentation $f:X\to C\IncludedIn\BaireSpace$, the topology on $X$ is generated
    by the preimages $f^{-1}[B]$ of the fixed-parameter analytic sets $B$. This is exactly the topology
    induced by $f$ from the ambient Gandy--Harrington topology. If $A\IncludedIn X$ is analytic in this
    presentation, then $f[A]$ is a fixed-parameter analytic set, and $f$ restricts to a homeomorphism from
    $A$ onto $f[A]$ with their relative topologies. Transporting the strategy once more proves (2) on $X$.
    \end{proof}
-/
theorem presentation_subspace_strongChoquet {X : Type*} {ε : ℕ → ℕ} {f : X → FusionReal}
    (hf : Function.Injective f) {A : Set X} (hA : Projected ε (f '' A)) :
    @StrongChoquetGame.IsStrongChoquet A
      (induced Subtype.val (presentationTopology ε f)) := by
  have h := presentation_strongChoquet (ε := ε)
    (f := fun x : A => f x) (hf.comp Subtype.val_injective)
  have hr : range (fun x : A => f x) = f '' A := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩; exact ⟨x.val, x.property, rfl⟩
    · rintro ⟨x, hx, rfl⟩; exact ⟨⟨x, hx⟩, rfl⟩
  rw [hr] at h
  change @StrongChoquetGame.IsStrongChoquet A
    (induced Subtype.val (induced f (parameterGHTopology ε)))
  rw [induced_compose]
  exact h hA

end PolishSpaceBook.LambdaTree.GHChoquet
