local instance effectiveScopeWordEncoding : Encodable (List ℕ) := NatListCode.encodable

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The first lightface classes can be described in terms of effective tests on names. For an effectively open set,
    membership is witnessed by a cylinder already seen in an enumeration. For an effectively closed set, nonmembership is
    witnessed by a forbidden finite prefix. For an effectively analytic set, membership is witnessed by an infinite sequence
    whose finite approximations pass all recursive tests. In this last case, the witness need not be finite or computable.
-/
theorem relativelyEffectivelyOpen_finite_witness {ε : ℕ → ℕ} {U : Set (ℕ → ℕ)}
    (hU : RelativelyEffectivelyOpen ε U) :
    ∃ W : Set (List ℕ), LambdaRelative.SemidecidablePredicate ε (· ∈ W) ∧
      ∀ p, p ∈ U ↔ ∃ s ∈ W, prefixOfSeq s p := by
  obtain ⟨W, hW, rfl⟩ := hU
  exact ⟨W, hW, fun _ => mem_cylinderCode⟩

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The first lightface classes can be described in terms of effective tests on names. For an effectively open set,
    membership is witnessed by a cylinder already seen in an enumeration. For an effectively closed set, nonmembership is
    witnessed by a forbidden finite prefix. For an effectively analytic set, membership is witnessed by an infinite sequence
    whose finite approximations pass all recursive tests. In this last case, the witness need not be finite or computable.
-/
theorem relativelyEffectivelyClosed_finite_counterwitness {ε : ℕ → ℕ} {F : Set (ℕ → ℕ)}
    (hF : RelativelyEffectivelyClosed ε F) :
    ∃ W : Set (List ℕ), LambdaRelative.SemidecidablePredicate ε (· ∈ W) ∧
      ∀ p, p ∉ F ↔ ∃ s ∈ W, prefixOfSeq s p :=
  relativelyEffectivelyOpen_finite_witness hF

/-- The parameter may be noncomputable. The fixed row program reads the
characteristic table of the cylinder family; no computable choice is asserted. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The passage from boldface to lightface mirrors the passage from arbitrary open subsets of Baire space to recursively
    enumerable lists of cylinders. Topologically, an open set is a union of basic cylinders:
    $$U = \bigcup_{s \in A}\cyl{s} \qquad (A \IncludedIn \finseq{\omega}).$$
    $U$ is effectively open when it has such an enumeration of cylinders generated by a lambda program. The lambda-calculus
    appendix fixes the indexing convention; here we use it to put an algorithmic constraint on every construction.
-/
theorem isOpen_iff_exists_relative_effectivelyOpen (U : Set (ℕ → ℕ)) :
    IsOpen U ↔ ∃ ε, RelativelyEffectivelyOpen ε U := by
  constructor
  · intro hU
    obtain ⟨ε, hε⟩ := LambdaRelative.predicates_in_one_parameter
      (fun _ : ℕ => fun s : List ℕ => s ∈ openCylinderCode U)
    exact ⟨ε, openCylinderCode U, ⟨_, (hε 0).semidecides⟩,
      (open_eq_cylinderCode_openCylinderCode hU).symm⟩
  · rintro ⟨ε, W, _, rfl⟩
    exact isOpen_cylinderCode W

theorem isClosed_iff_exists_relative_effectivelyClosed (F : Set (ℕ → ℕ)) :
    IsClosed F ↔ ∃ ε, RelativelyEffectivelyClosed ε F := by
  simpa only [RelativelyEffectivelyClosed, isOpen_compl_iff] using
    isOpen_iff_exists_relative_effectivelyOpen Fᶜ

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    Coanalytic sets are complements of such projections, so they are well-foundedness conditions.
-/
theorem coanalytic_section_tree {ε : ℕ → ℕ} {A : Set (ℕ → ℕ)}
    (hA : LambdaTree.Projected ε Aᶜ) :
    ∃ T : LambdaTree.PairTree ε, ∀ p,
      p ∈ A ↔ WellFounded (strictTreeExtension (T.section p).tree) := by
  obtain ⟨T, hT⟩ := hA
  refine ⟨T, fun p => ?_⟩
  have he : p ∈ A ↔ p ∉ pairTreeProjection T.tree := by rw [← hT]; simp
  exact he.trans ((not_mem_pairTreeProjection_iff_section_wellFounded T.tree p).trans
    (prefixTreeWellFounded_iff _ (T.section p).downward))

theorem coanalyticSet_iff_exists_relative_projection (A : Set (ℕ → ℕ)) :
    CoanalyticSet A ↔ ∃ ε, LambdaTree.Projected ε Aᶜ :=
  LambdaTree.analyticSet_iff_exists_parameter Aᶜ

/-- One recursive ordinal bounds all nodes, so their supremum remains below CK. -/
theorem recursive_tree_height_lt_bound {ε : ℕ → ℕ} (T : LambdaTree.PrefixTree ε)
    (hw : WellFounded (strictTreeExtension T.tree)) :
    (⨆ s : T.tree, (hw.apply s).rank) < LambdaRelative.recursiveOrdinalBound ε := by
  obtain ⟨W, hW, hbound⟩ := KleeneBrouwer.recursive_bound_of_no_branch T
    ((prefixTreeWellFounded_iff T.tree T.downward).mpr hw)
  apply lt_of_le_of_lt (Ordinal.iSup_le _) hW
  intro s
  obtain ⟨hs, hh⟩ := hbound s
  exact hh.le

/-- Totality supplies a function and the same program computes every digit.
This does not decide whether the supplied index is total. -/
/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The set of total computable functions is countable but not closed; totality is a $\lPi^0_2$ condition on indices,
        not a topological closedness condition on points.
-/
theorem totalIndex_iff_computes_name (ε : ℕ → ℕ) (e : ℕ) :
    LambdaTree.TotalIndex ε e ↔ ∃ p : ℕ → ℕ,
      LambdaRelative.Computes ε (Term.closedProgram e) p := by
  constructor
  · intro ht
    exact ⟨fun n => (ht n).choose, Term.closedProgram_closed e, fun n => (ht n).choose_spec⟩
  · rintro ⟨p, hp⟩ n
    exact ⟨p n, hp.2 n⟩

theorem borel_iff_positive_countable_sigma_level (A : Set (ℕ → ℕ)) :
    MeasurableSet A ↔ ∃ α : Ordinal.{0}, 1 ≤ α ∧ α < ω₁ ∧ A ∈ borelSigma α := by
  let : MetricSpace (ℕ → ℕ) := TopologicalSpace.metrizableSpaceMetric (ℕ → ℕ)
  have hU (n : ℕ) : IsOpen (cylinderBasis n) := isOpen_cyl _
  constructor
  · intro hA
    obtain ⟨c, hc, hca⟩ := (measurableSet_iff_hasCode A).mp hA
    refine ⟨c.level hc [], ?_, c.level_lt_omega_one hc [], ?_⟩
    · rw [← toCode_level]
      exact BorelCode.one_le_lvl _
    · rw [← hca]
      exact c.evaluate_mem_borelSigma_level hc cylinderBasis hU [] hc.1
  · rintro ⟨α, hα, hαω, hA⟩
    have hAω : A ∈ borelSigma (ω₁ : Ordinal.{0}) := borelSigma_mono hα hαω.le hA
    have hBasis : TopologicalSpace.IsTopologicalBasis (Set.range cylinderBasis) := by
      convert (isTopologicalBasis_cyl (A := ℕ)) using 1
      ext V
      constructor
      · rintro ⟨n, rfl⟩
        exact ⟨NatListCode.decode n, rfl⟩
      · rintro ⟨s, rfl⟩
        exact ⟨NatListCode.encode s, by simp [cylinderBasis]⟩
    obtain ⟨c, rfl⟩ := BorelCode.exists_decode_eq cylinderBasis hBasis hAω
    clear hA hAω hα hαω
    induction c with
    | leaf n => exact (hU n).measurableSet
    | union f ih => exact MeasurableSet.iUnion ih
    | compl c ih => exact ih.compl

/-@ booklink:
  source: polish-space-book/effective-dst-lightface-hierarchies.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The hyperarithmetic and Borel hierarchies give parallel characterizations:
    $$
    \HyperarithmeticalSets \;=\; \lDelta^1_1,
    \qquad
    \bigcup_{1\le\alpha < \omegaOneOrd} \bSigma^0_\alpha \;=\; \bDelta^1_1.
    $$
-/
theorem countable_borel_levels_iff_analytic_compl (A : Set (ℕ → ℕ)) :
    (∃ α : Ordinal.{0}, 1 ≤ α ∧ α < ω₁ ∧ A ∈ borelSigma α) ↔
      AnalyticSet A ∧ AnalyticSet Aᶜ := by
  rw [← borel_iff_positive_countable_sigma_level]
  exact ⟨fun h => ⟨h.analyticSet, h.compl.analyticSet⟩, fun h => h.1.measurableSet_of_compl h.2⟩

end PolishSpaceBook
