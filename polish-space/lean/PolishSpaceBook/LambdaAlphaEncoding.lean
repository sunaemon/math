module

public import PolishSpaceBook.LambdaAlphaEquivalence

@[expose] public section

/-!
# Binding trees, alpha-equivalence, and capture-avoiding substitution

The binding tree retains free variable names and records bound occurrences by
zero-based distance to their binder. Equality of these finite trees characterizes
the equivalence generated by named binder renaming. The main substitution theorem follows the book's named
substitution, including its least-fresh-variable renaming branch.
-/
namespace PolishSpaceBook.NamedLambda

/-- A locally nameless tree: bound indices count intervening abstractions. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: prose
  excerpt: |
    For a numerical implementation of the comparison, associate a finite
    \termdefineas{lambda binding tree}{locally nameless syntax tree} $\LambdaBindingTree{M}$ to each named term. Keep
    application nodes and abstraction nodes, but erase the variable name attached to each abstraction. A free occurrence
    retains its variable name as a free leaf. A bound occurrence becomes a bound leaf labeled by the number of intervening
    abstractions between that occurrence and its binder: the innermost binder has index zero. Free leaves and bound leaves
    are distinct kinds of leaf. Thus shadowing is recorded by the actual binding structure, rather than by the spelling of a
    variable.
-/
inductive BindingTree where
  | free : ℕ → BindingTree
  | bound : ℕ → BindingTree
  | app : BindingTree → BindingTree → BindingTree
  | lam : BindingTree → BindingTree
  deriving DecidableEq, Repr

namespace BindingTree

def fv : BindingTree → Finset ℕ
  | .free x => {x}
  | .bound _ => ∅
  | .app A B => A.fv ∪ B.fv
  | .lam A => A.fv

/-- Bind free occurrences of `x`, beneath `k` intervening abstractions. -/
def close (x k : ℕ) : BindingTree → BindingTree
  | .free y => if y = x then .bound k else .free y
  | .bound i => .bound i
  | .app A B => .app (close x k A) (close x k B)
  | .lam A => .lam (close x (k + 1) A)

/-- Replace free occurrences. The inserted tree will be locally closed. -/
def subst (A : BindingTree) (x : ℕ) (N : BindingTree) : BindingTree :=
  match A with
  | .free y => if y = x then N else .free y
  | .bound i => .bound i
  | .app A B => .app (subst A x N) (subst B x N)
  | .lam A => .lam (subst A x N)

@[simp] theorem fv_close (A : BindingTree) (x k : ℕ) :
    (close x k A).fv = A.fv.erase x := by
  induction A generalizing k with
  | free y =>
    by_cases h : y = x
    · subst y; simp [close, fv]
    · simp [close, fv, h, Ne.symm h]
  | bound i => simp [close, fv]
  | app A B ihA ihB => simp [close, fv, ihA, ihB, Finset.erase_union_distrib]
  | lam A ih => simp [close, fv, ih]

theorem close_eq_self (A : BindingTree) (x k : ℕ) (h : x ∉ A.fv) :
    close x k A = A := by
  induction A generalizing k with
  | free y => simp only [fv, Finset.mem_singleton] at h; simp [close, Ne.symm h]
  | bound i => rfl
  | app A B ihA ihB =>
    simp only [fv, Finset.mem_union, not_or] at h
    simp only [close, ihA k h.1, ihB k h.2]
  | lam A ih => simp only [close, ih (k + 1) h]

theorem subst_eq_self (A : BindingTree) (x : ℕ) (N : BindingTree) (h : x ∉ A.fv) :
    A.subst x N = A := by
  induction A with
  | free y => simp only [fv, Finset.mem_singleton] at h; simp [subst, Ne.symm h]
  | bound i => rfl
  | app A B ihA ihB =>
    simp only [fv, Finset.mem_union, not_or] at h
    simp only [subst, ihA h.1, ihB h.2]
  | lam A ih => simp only [subst, ih h]

theorem subst_close_self (A : BindingTree) (x k : ℕ) (N : BindingTree) :
    (close x k A).subst x N = close x k A :=
  subst_eq_self _ _ _ (by simp)

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    First observe two identities by induction on a tree. Closing a variable commutes with replacement of a different free variable if the inserted tree has no free occurrence of the variable being closed. Also, replacing free $y$ leaves by a fresh free $z$ leaf and then closing $z$ gives the same tree as directly closing $y$. For the second identity, freshness excludes any pre-existing free $z$ leaf. Both identities continue beneath an abstraction with the closing depth increased by one.
-/
theorem close_subst (A N : BindingTree) (y x k : ℕ)
    (hne : y ≠ x) (hf : y ∉ N.fv) :
    close y k (A.subst x N) = (close y k A).subst x N := by
  induction A generalizing k with
  | free v =>
    by_cases hx : v = x
    · subst v; simp [subst, close, Ne.symm hne, close_eq_self N y k hf]
    · by_cases hy : v = y
      · subst v; simp [subst, close, hne]
      · simp [subst, close, hx, hy]
  | bound i => rfl
  | app A B ihA ihB => simp only [subst, close, ihA, ihB]
  | lam A ih => simp only [subst, close, ih]

/-- Renaming to a fresh name and then binding it changes no binding tree. -/
theorem close_rename (A : BindingTree) (y z k : ℕ) (hz : z ∉ A.fv) :
    close z k (A.subst y (.free z)) = close y k A := by
  induction A generalizing k with
  | free v =>
    have hvz : v ≠ z := by simpa only [fv, Finset.mem_singleton, ne_eq, eq_comm] using hz
    by_cases hvy : v = y <;> simp [subst, close, hvy, hvz]
  | bound i => rfl
  | app A B ihA ihB =>
    simp only [fv, Finset.mem_union, not_or] at hz
    simp only [subst, close, ihA k hz.1, ihB k hz.2]
  | lam A ih => simp only [subst, close, ih (k + 1) hz]

/-- Every bound index in a tree well scoped at depth `d` is smaller than its local depth. -/
def Scoped : ℕ → BindingTree → Prop
  | _, .free _ => True
  | d, .bound i => i < d
  | d, .app A B => Scoped d A ∧ Scoped d B
  | d, .lam A => Scoped (d + 1) A

theorem scoped_mono {A : BindingTree} {d e : ℕ} (h : A.Scoped d) (hde : d ≤ e) :
    A.Scoped e := by
  induction A generalizing d e with
  | free x => trivial
  | bound i => exact lt_of_lt_of_le h hde
  | app A B ihA ihB => exact ⟨ihA h.1 hde, ihB h.2 hde⟩
  | lam A ih => exact ih h (Nat.add_le_add_right hde 1)

theorem scoped_close {A : BindingTree} {d k : ℕ} (h : A.Scoped d) (hk : k ≤ d) (x : ℕ) :
    (close x k A).Scoped (d + 1) := by
  induction A generalizing d k with
  | free y => by_cases hy : y = x <;> simp [close, Scoped, hy]; omega
  | bound i => exact Nat.lt_succ_of_lt h
  | app A B ihA ihB => exact ⟨ihA h.1 hk, ihB h.2 hk⟩
  | lam A ih => exact ih h (Nat.add_le_add_right hk 1)

/-- Open the binder at depth `k`; inputs from named syntax have no dangling indices. -/
def openAt (k : ℕ) (A N : BindingTree) : BindingTree :=
  match A with
  | .free x => .free x
  | .bound i => if i = k then N else .bound i
  | .app A B => .app (openAt k A N) (openAt k B N)
  | .lam A => .lam (openAt (k + 1) A N)

theorem open_close {A : BindingTree} (h : A.Scoped k) (x : ℕ) (N : BindingTree) :
    openAt k (close x k A) N = A.subst x N := by
  induction A generalizing k with
  | free y => by_cases hy : y = x <;> simp [close, openAt, subst, hy]
  | bound i => have hi : i ≠ k := Nat.ne_of_lt h; simp [close, openAt, subst, hi]
  | app A B ihA ihB => simp only [close, openAt, subst, ihA h.1, ihB h.2]
  | lam A ih => simp only [close, openAt, subst, ih h]

end BindingTree

namespace Term

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: prose
  excerpt: |
    The construction is recursive. A variable gives a free leaf, and application combines two trees. For $\lambdaab{x}{M}$, first construct $\LambdaBindingTree{M}$, then replace each free $x$ leaf by a bound leaf whose index is the number of abstractions passed while descending to that leaf, and finally add the outer abstraction node. Call this replacement operation closing the free variable $x$. Existing bound leaves do not change. Induction shows that every bound index in a tree constructed from a named term points to an enclosing abstraction. The theorem below proves that two terms are alpha-equivalent exactly when these representations agree.
-/
def bindingTree : Term → BindingTree
  | .var x => .free x
  | .app M N => .app M.bindingTree N.bindingTree
  | .lam x M => .lam (BindingTree.close x 0 M.bindingTree)

@[simp] theorem bindingTree_fv (M : Term) : M.bindingTree.fv = M.fv := by
  induction M with
  | var x => rfl
  | app M N ihM ihN => simp [bindingTree, BindingTree.fv, fv, ihM, ihN]
  | lam x M ih => simp [bindingTree, BindingTree.fv, fv, ih]

theorem bindingTree_scoped (M : Term) : M.bindingTree.Scoped 0 := by
  induction M with
  | var x => trivial
  | app M N ihM ihN => exact ⟨ihM, ihN⟩
  | lam x M ih => exact BindingTree.scoped_close ih le_rfl x

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    Now induct on the node-count bound for named substitution. Variables and applications follow directly from the definitions. In an abstraction binding $x$, substitution stops, and its tree has no free $x$ leaf to replace. In an abstraction binding a different variable absent from the replacement's free-variable set, apply the induction hypothesis to the body and use the first identity.

    In the renaming branch, first apply the induction hypothesis to the variable replacement in the body. Its node count is unchanged, so the hypothesis also applies to the following substitution. The chosen fresh variable occurs freely in neither the original body nor the replacement. The first identity moves closing past the final substitution, and the second removes the intermediate renaming. The result is exactly free-leaf replacement in the original abstraction's tree. The inserted tree has no dangling bound index, so its internal binding structure remains intact under any surrounding abstractions.
-/
private theorem bindingTree_subst_bounded (k : ℕ) (M : Term) (x : ℕ) (N : Term)
    (hM : M.nodes ≤ k) :
    (M.subst x N).bindingTree = M.bindingTree.subst x N.bindingTree := by
  induction k generalizing M x N with
  | zero => have := M.nodes_pos; omega
  | succ k ih =>
    cases M with
    | var y => by_cases hy : y = x <;> simp [subst_var, bindingTree, BindingTree.subst, hy]
    | app M P =>
      have hm : M.nodes ≤ k := by simp only [nodes] at hM; omega
      have hp : P.nodes ≤ k := by simp only [nodes] at hM; omega
      simp only [subst_app, bindingTree, BindingTree.subst, ih M x N hm, ih P x N hp]
    | lam y M =>
      have hm : M.nodes ≤ k := by simpa only [nodes, Nat.add_le_add_iff_right] using hM
      rw [subst_lam]
      by_cases hy : y = x
      · subst y
        simp only [ite_true, bindingTree, BindingTree.subst,
          BindingTree.subst_close_self]
      · simp only [ite_eq_right hy]
        by_cases hf : y ∉ N.fv
        · simp only [ite_eq_left hf, bindingTree, BindingTree.subst, ih M x N hm]
          rw [BindingTree.close_subst _ _ y x 0 hy (by simpa using hf)]
        · simp only [ite_eq_right hf]
          let z := fresh (M.fv ∪ N.fv ∪ {x})
          have hz : z ∉ M.fv ∧ z ∉ N.fv ∧ z ≠ x := by
            have hh := fresh_not_mem (M.fv ∪ N.fv ∪ {x})
            simpa only [z, Finset.mem_union, Finset.mem_singleton, not_or, and_assoc] using hh
          change BindingTree.lam (BindingTree.close z 0
            (((M.subst y (var z)).subst x N).bindingTree)) = _
          rw [ih (M.subst y (var z)) x N (by simpa only [nodes_subst_var] using hm),
            ih M y (var z) hm]
          simp only [bindingTree, BindingTree.subst]
          rw [BindingTree.close_subst _ _ z x 0 hz.2.2 (by simpa using hz.2.1),
            BindingTree.close_rename _ y z 0 (by simpa using hz.1)]

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: lemma
  title: Substitution and indexed trees
-/
theorem bindingTree_subst (M : Term) (x : ℕ) (N : Term) :
    (M.subst x N).bindingTree = M.bindingTree.subst x N.bindingTree :=
  bindingTree_subst_bounded M.nodes M x N le_rfl

/-- Alpha-equivalence retains free names and precisely the binding structure. -/
def TreeAlpha (M N : Term) : Prop := M.bindingTree = N.bindingTree

instance (M N : Term) : Decidable (TreeAlpha M N) := inferInstanceAs (Decidable (_ = _))

@[refl] theorem TreeAlpha.refl (M : Term) : TreeAlpha M M := rfl
@[symm] theorem TreeAlpha.symm {M N : Term} (h : TreeAlpha M N) : TreeAlpha N M := Eq.symm h
@[trans] theorem TreeAlpha.trans {M N P : Term} (h : TreeAlpha M N) (h' : TreeAlpha N P) :
    TreeAlpha M P := Eq.trans h h'

theorem TreeAlpha.app {M M' N N' : Term} (hM : TreeAlpha M M') (hN : TreeAlpha N N') :
    TreeAlpha (app M N) (app M' N') := by
  change M.bindingTree = M'.bindingTree at hM
  change N.bindingTree = N'.bindingTree at hN
  simp only [TreeAlpha, bindingTree, hM, hN]

theorem TreeAlpha.lam {M M' : Term} (hM : TreeAlpha M M') (x : ℕ) :
    TreeAlpha (lam x M) (lam x M') := by
  change M.bindingTree = M'.bindingTree at hM
  simp only [TreeAlpha, bindingTree, hM]

theorem TreeAlpha.fv_eq {M N : Term} (h : TreeAlpha M N) : M.fv = N.fv := by
  rw [← bindingTree_fv, ← bindingTree_fv]; exact congrArg BindingTree.fv h

theorem TreeAlpha.closed_iff {M N : Term} (h : TreeAlpha M N) : M.Closed ↔ N.Closed := by
  unfold Closed; rw [h.fv_eq]

theorem TreeAlpha.subst {M M' N N' : Term} (hM : TreeAlpha M M') (hN : TreeAlpha N N') (x : ℕ) :
    TreeAlpha (M.subst x N) (M'.subst x N') := by
  change M.bindingTree = M'.bindingTree at hM
  change N.bindingTree = N'.bindingTree at hN
  simp only [TreeAlpha, bindingTree_subst, hM, hN]

/-- Any fresh binder name gives the same alpha-class, not just the least one. -/
theorem treeAlpha_rename (M : Term) (x z : ℕ) (hz : z ∉ M.fv) :
    TreeAlpha (lam x M) (lam z (M.subst x (var z))) := by
  simp only [TreeAlpha, bindingTree, bindingTree_subst]
  rw [BindingTree.close_rename _ x z 0 (by simpa using hz)]

theorem treeAlpha_fresh_choice (M : Term) (x z w : ℕ) (hz : z ∉ M.fv) (hw : w ∉ M.fv) :
    TreeAlpha (lam z (M.subst x (var z))) (lam w (M.subst x (var w))) :=
  (treeAlpha_rename M x z hz).symm.trans (treeAlpha_rename M x w hw)

/-- Alpha-equivalent abstractions and arguments have alpha-equivalent contracta. -/
theorem treeAlpha_contract {M M' N N' : Term} {x y : ℕ}
    (hM : TreeAlpha (lam x M) (lam y M')) (hN : TreeAlpha N N') :
    TreeAlpha (M.subst x N) (M'.subst y N') := by
  have hb : BindingTree.close x 0 M.bindingTree = BindingTree.close y 0 M'.bindingTree :=
    BindingTree.lam.inj hM
  change (M.subst x N).bindingTree = (M'.subst y N').bindingTree
  rw [bindingTree_subst, bindingTree_subst,
    ← BindingTree.open_close (bindingTree_scoped M),
    ← BindingTree.open_close (bindingTree_scoped M'), hb, hN]


/-- Open alpha-equivalent abstractions at one shared free variable. -/
theorem TreeAlpha.rename_bodies {M N : Term} {x y : ℕ}
    (h : TreeAlpha (Term.lam x M) (Term.lam y N)) (z : ℕ) :
    TreeAlpha (M.subst x (var z)) (N.subst y (var z)) :=
  treeAlpha_contract h (TreeAlpha.refl _)

/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    Equality of the auxiliary trees is preserved by application and abstraction. The closing identity in the preceding lemma shows that each generating binder renaming preserves the tree. Induction on the derivation of alpha-equivalence therefore proves that alpha-equivalent terms have equal trees.
-/
theorem RenameEq.treeAlpha {M N : Term} (h : RenameEq M N) : TreeAlpha M N := by
  induction h with
  | refl M => exact TreeAlpha.refl M
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | app _ _ ih₁ ih₂ => exact ih₁.app ih₂
  | lam x _ ih => exact ih.lam x
  | rename M x z hz => exact treeAlpha_rename M x z hz

private theorem treeAlpha_renameEq_bounded (k : ℕ) (M N : Term) (hk : M.nodes ≤ k)
    (h : TreeAlpha M N) : RenameEq M N := by
  induction k generalizing M N with
  | zero => have := M.nodes_pos; omega
  | succ k ih =>
    cases M <;> cases N
    case var.var x y =>
      have he : x = y := BindingTree.free.inj h
      subst y; exact .refl _
    case var.app => cases h
    case var.lam => cases h
    case app.var => cases h
    case app.app M P N Q =>
      have hm : M.nodes ≤ k := by simp only [nodes] at hk; omega
      have hp : P.nodes ≤ k := by simp only [nodes] at hk; omega
      have hs := BindingTree.app.inj h
      exact .app (ih M N hm hs.1) (ih P Q hp hs.2)
    case app.lam => cases h
    case lam.var => cases h
    case lam.app => cases h
    case lam.lam x M y N =>
      let z := fresh (M.fv ∪ N.fv)
      have hz : z ∉ M.fv ∧ z ∉ N.fv := by
        simpa only [z, Finset.mem_union, not_or] using fresh_not_mem (M.fv ∪ N.fv)
      have hm : (M.subst x (var z)).nodes ≤ k := by
        simp only [nodes] at hk
        rw [nodes_subst_var]; omega
      have hb := ih (M.subst x (var z)) (N.subst y (var z)) hm (h.rename_bodies z)
      exact RenameEq.trans (RenameEq.rename M x z hz.1)
        (RenameEq.trans (RenameEq.lam z hb) (RenameEq.symm (RenameEq.rename N y z hz.2)))

/-- Tree equality is exactly the familiar equivalence generated by binder renaming. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: proof
  excerpt: |
    For the converse, induct on a node-count bound for the first of two terms with equal trees. Equal trees have the same outer constructor. Variable leaves have the same name, and applications reduce to their two pairs of subterms. For two abstractions, choose one variable fresh for both bodies. Open each outer binder by replacing its bound occurrences by that free variable. To locate those occurrences beneath further abstractions, increase the target index by one at each descent. Opening a closed free variable in a tree made from a named term is precisely replacement of its free leaves: no pre-existing bound index can point to the newly added outer binder. Consequently, equality of the abstraction trees gives equality of the trees of the two renamed bodies. Their node counts equal those of the original bodies. Apply the induction hypothesis, lift through the common abstraction, and compose with the fresh renaming on either side. This produces the required finite sequence of renamings and context steps.
-/
theorem treeAlpha_iff_renameEq (M N : Term) : TreeAlpha M N ↔ RenameEq M N :=
  ⟨treeAlpha_renameEq_bounded M.nodes M N le_rfl, RenameEq.treeAlpha⟩


/-- The decision representation is equivalent to the primary named relation. -/
/-@ booklink:
  source: polish-space-book/appendix-lambda-calculus-computability.md
  target: statement
  kind: lemma
  title: Indexed syntax and alpha-equivalence
-/
theorem alpha_iff_bindingTree (M N : Term) : Alpha M N ↔ M.bindingTree = N.bindingTree :=
  (treeAlpha_iff_renameEq M N).symm


end Term
end PolishSpaceBook.NamedLambda
