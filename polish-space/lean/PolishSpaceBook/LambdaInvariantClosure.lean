module

public import PolishSpaceBook.LambdaInvariantSeparation
public import PolishSpaceBook.HKLHereditaryGeometry

@[expose] public section

/-! # Invariant tests and GH closure at a fixed lambda parameter -/

namespace PolishSpaceBook
open Set TopologicalSpace
namespace LambdaTree

theorem projected_relationGapImage {ε : ℕ → ℕ}
    (E F : Setoid (ℕ → ℕ)) (hF : ProjectedRelation ε F.r)
    (hE : ProjectedRelation ε (fun x y => ¬ E.r x y))
    {A : Set (ℕ → ℕ)} (hA : Projected ε A) :
    Projected ε (relationGapImage E F A) :=
  projected_relationalImage (hF.inter hE) hA

/-- Indistinguishability by all complemented invariant tests in one parameter. -/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    Let $\mathcal I$ be the family of $E$-invariant $\lDelta^1_1$ sets at the fixed parameter.
    Define the auxiliary equivalence relation by
    $$x\mathrel{\EffectiveClosureER{E}}y
    \quad\Longleftrightarrow\quad
    \forall D\in\mathcal I\ (x\in D\ \Longleftrightarrow\ y\in D).$$
-/
def invariantSetoid (ε : ℕ → ℕ) (E : Setoid (ℕ → ℕ)) : Setoid (ℕ → ℕ) where
  r x y := ∀ C, Complemented ε C →
    ERInvariant E C → (x ∈ C ↔ y ∈ C)
  iseqv := ⟨fun _ _ _ _ => Iff.rfl, fun h C hc hi => (h C hc hi).symm,
    fun hxy hyz C hc hi => (hxy C hc hi).trans (hyz C hc hi)⟩

theorem relation_le_invariantSetoid (ε : ℕ → ℕ) (E : Setoid (ℕ → ℕ))
    {x y : ℕ → ℕ} (hxy : E.r x y) : (invariantSetoid ε E).r x y :=
  fun _ _ hi => hi hxy

/-- The separation argument in the closure identity, expressed first on
basic relative analytic neighborhoods. -/
theorem invariantSetoid_iff_analytic_neighbors (ε : ℕ → ℕ) (E : Setoid (ℕ → ℕ))
    (hE : ProjectedRelation ε E.r) (x y : ℕ → ℕ) :
    (invariantSetoid ε E).r x y ↔
      ∀ A B, Projected ε A →
        Projected ε B → x ∈ A → y ∈ B →
        ∃ a ∈ A, ∃ b ∈ B, E.r a b := by
  classical
  constructor
  · intro hxy A B hA hB hx hy
    by_contra hn
    have hd : Disjoint (erSaturation E A) (erSaturation E B) := by
      apply Set.disjoint_left.mpr
      rintro z ⟨a, ha, haz⟩ ⟨b, hb, hbz⟩
      exact hn ⟨a, ha, b, hb, E.trans haz (E.symm hbz)⟩
    obtain ⟨C, hc, hi, hAC, hCB⟩ := invariant_separation ε E hE
      (projected_erSaturation E hE hA) (projected_erSaturation E hE hB)
      hd (erSaturation_invariant E B)
    have hxC := hAC (subset_erSaturation E A hx)
    have hyC := (hxy C hc hi).mp hxC
    exact Set.disjoint_left.mp hCB hyC (subset_erSaturation E B hy)
  · intro hn C hc hi
    constructor
    · intro hx
      by_contra hy
      obtain ⟨a, ha, b, hb, hab⟩ := hn C Cᶜ hc.1 hc.2 hx hy
      exact hb ((hi hab).mp ha)
    · intro hy
      by_contra hx
      obtain ⟨a, ha, b, hb, hab⟩ := hn Cᶜ C hc.2 hc.1 hx hy
      exact ha ((hi hab).mpr hb)

/-- The topology generated by the relative analytic sets, with one fixed
parameter. It is deliberately not installed as the usual Baire topology. -/
abbrev ghTopology (ε : ℕ → ℕ) : TopologicalSpace (ℕ → ℕ) :=
  generateFrom {A | Projected ε A}

theorem gh_basis (ε : ℕ → ℕ) :
    @IsTopologicalBasis (ℕ → ℕ) (ghTopology ε)
      {A | Projected ε A} := by
  have hu : Projected ε (univ : Set (ℕ → ℕ)) := by
    simpa using projected_cyl ε []
  have humem : univ ∈ {A | Projected ε A} := hu
  simpa only [insert_eq_of_mem humem] using
    (isTopologicalBasis_of_subbasis_of_inter (t := ghTopology ε) rfl
      (fun _ hA _ hB => hA.inter hB))

/-- Canonical topological closure, in the product of the two GH topologies. -/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    The relation $\EffectiveClosureER{E}$ is exactly the closure of $E$ in the product of the two
    Gandy--Harrington topologies. A separating invariant $\lDelta^1_1$ set gives disjoint basic neighborhoods with no
    $E$-pair between them. Conversely, if analytic neighborhoods $A,B$ have no such pair, their $E$-saturations are
    disjoint analytic invariant sets; invariant separation gives a $\lDelta^1_1$ invariant set distinguishing every
    point of $A$ from every point of $B$.
-/
theorem invariantSetoid_iff_mem_closure (ε : ℕ → ℕ) (E : Setoid (ℕ → ℕ))
    (hE : ProjectedRelation ε E.r) (x y : ℕ → ℕ) :
    letI := ghTopology ε
    (invariantSetoid ε E).r x y ↔
      (x, y) ∈ closure {p : (ℕ → ℕ) × (ℕ → ℕ) | E.r p.1 p.2} := by
  let := ghTopology ε
  rw [invariantSetoid_iff_analytic_neighbors ε E hE,
    ((gh_basis ε).prod (gh_basis ε)).mem_closure_iff]
  constructor
  · intro h U hU hxy
    obtain ⟨A, hA, B, hB, rfl⟩ := hU
    obtain ⟨a, ha, b, hb, hab⟩ := h A B hA hB hxy.1 hxy.2
    exact ⟨(a, b), ⟨ha, hb⟩, hab⟩
  · intro h A B hA hB hx hy
    obtain ⟨⟨a, b⟩, ⟨ha, hb⟩, hab⟩ := h (A ×ˢ B) ⟨A, hA, B, hB, rfl⟩ ⟨hx, hy⟩
    exact ⟨a, ha, b, hb, hab⟩

/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    Suppose they agree on $A$. Put $Y=\ERSaturation{A}{E}$ and $Z=\ERSaturation{A}{\EffectiveClosureER{E}}$.
-/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    : if $z\in Y$, any two such representatives from $A$ would be
    $\EffectiveClosureER{E}$-equivalent and therefore $E$-equivalent. Thus $Y,Y'$ are disjoint analytic invariant sets.
    If $Y'$ were nonempty, invariant separation would give an invariant $\lDelta^1_1$ set containing $Y$ and disjoint
    from $Y'$. But every point of $Y'$ is $\EffectiveClosureER{E}$-equivalent to a point of $A\IncludedIn Y$, a
    contradiction. Hence $Z=Y$. Agreement on $Y$ now says that every $\EffectiveClosureER{E}$-class meeting $A$ is a
    single $E$-class, contradicting $A\IncludedIn H$.
-/
/-- Hereditary failure from a relative analytic code for the actual
invariant-test relation. `hkl_hereditary` supplies this code using
uniform separator tests. -/
theorem hkl_hereditary_failure (ε : ℕ → ℕ) (E : Setoid (ℕ → ℕ))
    (hE : ProjectedRelation ε E.r)
    (hneE : ProjectedRelation ε (fun x y => ¬ E.r x y))
    (hF : ProjectedRelation ε (invariantSetoid ε E).r)
    {A : Set (ℕ → ℕ)} (hA : Projected ε A)
    (hne : A.Nonempty) (hAH : A ⊆ equivalenceGapKernel E (invariantSetoid ε E)) :
    ∃ x ∈ A, ∃ y ∈ A, (invariantSetoid ε E).r x y ∧ ¬ E.r x y := by
  classical
  by_contra hn
  have hagree : ∀ x ∈ A, ∀ y ∈ A, (invariantSetoid ε E).r x y → E.r x y := by
    intro x hx y hy hxy
    by_contra hne
    exact hn ⟨x, hx, y, hy, hxy, hne⟩
  have hEF : ∀ ⦃x y⦄, E.r x y → (invariantSetoid ε E).r x y :=
    fun {_ _} h => relation_le_invariantSetoid ε E h
  have hgap := projected_relationGapImage E (invariantSetoid ε E) hF hneE hA
  obtain ⟨C, hc, hi, hYC, hCd⟩ := invariant_separation ε E hE
    (projected_erSaturation E hE hA) hgap
    (relationGapImage_disjoint_saturation E (invariantSetoid ε E) hEF hagree)
    (relationGapImage_invariant E (invariantSetoid ε E) hEF hagree)
  obtain ⟨z, hz⟩ := relationGapImage_nonempty E (invariantSetoid ε E) hne hAH
  obtain ⟨a, ha, haz, hneaz⟩ := hz
  have hzC := (haz C hc hi).mp (hYC (subset_erSaturation E A ha))
  exact Set.disjoint_left.mp hCd hzC ⟨a, ha, haz, hneaz⟩

end LambdaTree
end PolishSpaceBook
