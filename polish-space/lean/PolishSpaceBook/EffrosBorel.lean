module

public import PolishSpaceBook.PolishEmbeddingsBorelRefinements
public import Mathlib.Topology.Sets.Closeds

@[expose] public section

/-!
# Effros–Borel spaces and ambient closure

The measurable structure on the canonical type `Closeds X` is generated by open
hit sets. The ambient-closure map and its image criterion follow the book's
proof, including the Baire-category step for a G-delta subspace.
-/

namespace PolishSpaceBook
namespace EffrosBorel

open Set TopologicalSpace Topology MeasurableSpace

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

/-- Closed sets meeting the given set. -/
def hit (U : Set X) : Set (Closeds X) := {F | ((F : Set X) ∩ U).Nonempty}

/-@ booklink:
  source: polish-space-book/standard-borel-classification-closed-sets.md
  target: prose
  excerpt: |
    The standard choice is the **\termdefineas{Effros--Borel space}{Effros–Borel structure}**: the $\sigma$-algebra
    generated by the \termdefineas{hit set}{hit sets}
    $$\{C \in \ClosedSets{X} : C \cap U \ne \emptyset\},$$
    where $U$ ranges over the open subsets of $X$.
    By complementation, the \termdefineas{miss set}{miss sets} $\{C : C \cap U = \emptyset\}$ generate the same
    $\sigma$-algebra.
-/
/-@ booklink:
  source: polish-space-book/standard-borel-classification-closed-sets.md
  target: prose
  excerpt: |
    Treating them as the *points* of a measurable space
    requires a $\sigma$-algebra on the set $\ClosedSets{X}$ of closed subsets of $X$ introduced in
    §{sec:closed-sets-trees}. Spaces whose points are subsets of another space are called
    \termdefineas{hyperspace}{hyperspaces}. Here each point is itself a closed set. We first specify the measurable
    structure on this collection; a topology will enter later in the proof.
-/
/-- The Effros measurable structure uses all open hit sets as generators. -/
@[instance_reducible]
def measurableSpace (X : Type*) [TopologicalSpace X] : MeasurableSpace (Closeds X) :=
  generateFrom (hit '' {U : Set X | IsOpen U})

attribute [local instance] measurableSpace

theorem measurable_hit {U : Set X} (hU : IsOpen U) : MeasurableSet (hit U) :=
  measurableSet_generateFrom ⟨U, hU, rfl⟩

theorem measurable_iff_hit {Z : Type*} [MeasurableSpace Z] {f : Z → Closeds X} :
    Measurable f ↔ ∀ U : Set X, IsOpen U → MeasurableSet (f ⁻¹' hit U) := by
  constructor
  · exact fun hf U hU => (measurable_hit hU).preimage hf
  · intro h
    apply measurable_generateFrom
    rintro _ ⟨U, hU, rfl⟩
    exact h U hU

/-- Close the image of a closed set in the ambient space. -/
def ambientClosure (f : X → Y) (F : Closeds X) : Closeds Y := Closeds.closure (f '' (F : Set X))

/-- Pull a closed set back along a continuous map. -/
def pullback (f : X → Y) (hf : Continuous f) (F : Closeds Y) : Closeds X :=
  ⟨f ⁻¹' (F : Set Y), F.isClosed.preimage hf⟩

theorem ambientClosure_hit_iff (f : X → Y) (F : Closeds X) {U : Set Y} (hU : IsOpen U) :
    ambientClosure f F ∈ hit U ↔ F ∈ hit (f ⁻¹' U) := by
  change (closure (f '' (F : Set X)) ∩ U).Nonempty ↔ ((F : Set X) ∩ f ⁻¹' U).Nonempty
  rw [closure_inter_open_nonempty_iff hU]
  constructor
  · rintro ⟨y, ⟨⟨x, hx, rfl⟩, hxU⟩⟩
    exact ⟨x, hx, hxU⟩
  · rintro ⟨x, hx, hxU⟩
    exact ⟨f x, ⟨x, hx, rfl⟩, hxU⟩

theorem ambientClosure_measurable (f : X → Y) (hf : Continuous f) :
    Measurable (ambientClosure f) := by
  apply measurable_iff_hit.mpr
  intro U hU
  have heq : ambientClosure f ⁻¹' hit U = hit (f ⁻¹' U) := by
    ext F
    exact ambientClosure_hit_iff f F hU
  rw [heq]
  exact measurable_hit (hU.preimage hf)

/-- The original closed set is recovered by intersecting the ambient closure
with the embedded copy of the source. -/
theorem pullback_ambientClosure (f : X → Y) (hf : IsEmbedding f) (F : Closeds X) :
    pullback f hf.continuous (ambientClosure f F) = F := by
  apply Closeds.ext
  change f ⁻¹' closure (f '' (F : Set X)) = (F : Set X)
  rw [← hf.closure_eq_preimage_closure_image, F.isClosed.closure_eq]

theorem ambientClosure_injective (f : X → Y) (hf : IsEmbedding f) :
    Function.Injective (ambientClosure f) := by
  intro F G h
  have := congrArg (pullback f hf.continuous) h
  simpa only [pullback_ambientClosure f hf] using this

/-@ booklink:
  source: polish-space-book/standard-borel-classification-closed-sets.md
  target: prose
  excerpt: |
    \emph{General Polish $X$.} Embed $X$ as a $\bPi^0_2$ subset of the \termuse{Hilbert cube}
    $\hat X := \HilbertCube$ using §{sec:hilbert-cube-embedding}. The map
    $$\Phi : \ClosedSets{X} \to \ClosedSets{\hat X}, \qquad C \mapsto \AmbientClosure{\hat X}{C},$$
    is injective: closure-in-subspace equals (closure-in-ambient) $\cap$ subspace, so $\AmbientClosure{\hat X}{C} \cap X =
    \AmbientClosure{X}{C} = C$ recovers $C$ from $\Phi(C)$. The image is
    $$\Phi(\ClosedSets{X}) = \{\tilde C \in \ClosedSets{\hat X} : \AmbientClosure{\hat X}{\tilde C\cap X}=\tilde C\}.$$
    Writing $X = \bigcap_n W_n$ with each $W_n$ open in $\hat X$, the Baire category theorem in the Polish space $\tilde C$
    reduces "$\tilde C \cap X$ dense in $\tilde C$" to "$\tilde C \cap W_n$ dense in $\tilde C$ for every $n$" —
    equivalently, for every basic open $U_k$ of $\hat X$ and every $n$, $\tilde C \cap U_k \ne \emptyset$ implies $\tilde C
    \cap (U_k \cap W_n) \ne \emptyset$. Each clause is an implication between two Effros–Borel hit sets, and the countable
    conjunction over $(n, k)$ is again Effros–Borel. So $\Phi(\ClosedSets{X})$ is Effros–Borel in
    $\ClosedSets{\hat X}$.
-/
/-- A closed ambient set is in the image exactly when its intersection with
the source is dense in it. -/
theorem range_ambientClosure (f : X → Y) (hf : IsEmbedding f) :
    range (ambientClosure f) = {F : Closeds Y | closure ((F : Set Y) ∩ range f) = F} := by
  ext F
  constructor
  · rintro ⟨C, rfl⟩
    apply subset_antisymm
    · exact closure_minimal inter_subset_left (ambientClosure f C).isClosed
    · change closure (f '' (C : Set X)) ⊆ _
      apply closure_mono
      rintro y ⟨x, hx, rfl⟩
      exact ⟨subset_closure ⟨x, hx, rfl⟩, mem_range_self x⟩
  · intro h
    refine ⟨pullback f hf.continuous F, ?_⟩
    apply Closeds.ext
    change closure (f '' (f ⁻¹' (F : Set Y))) = _
    simpa only [mem_ofPred_eq, image_preimage_eq_inter_range] using h

/-- Density in a closed set can be tested on a basis of the ambient space. -/
theorem dense_inter_basis_iff (F : Closeds Y) (U : ℕ → Set Y)
    (hU : IsTopologicalBasis (range U)) (W : Set Y) :
    (F : Set Y) ⊆ closure ((F : Set Y) ∩ W) ↔
      ∀ k, F ∈ hit (U k) → F ∈ hit (U k ∩ W) := by
  constructor
  · intro h k hhit
    obtain ⟨x, hxF, hxU⟩ := hhit
    obtain ⟨y, hyU, hyF, hyW⟩ :=
      (mem_closure_iff.mp (h hxF)) (U k) (hU.isOpen (mem_range_self k)) hxU
    exact ⟨y, hyF, hyU, hyW⟩
  · intro h x hxF
    apply mem_closure_iff.mpr
    intro V hV hxV
    obtain ⟨_, ⟨k, rfl⟩, hxU, hUV⟩ := hU.exists_subset_of_mem_open hxV hV
    obtain ⟨y, hyF, hyU, hyW⟩ := h k ⟨x, hxF, hxU⟩
    exact ⟨y, hUV hyU, hyF, hyW⟩

/-- The book's Baire-category step, applied inside each closed ambient set.
The empty closed set is included: both sides then hold vacuously. -/
theorem closure_inter_iInter_eq_iff [PolishSpace Y] (F : Closeds Y)
    (W : ℕ → Set Y) (hW : ∀ n, IsOpen (W n)) :
    closure ((F : Set Y) ∩ ⋂ n, W n) = F ↔
      ∀ n, (F : Set Y) ⊆ closure ((F : Set Y) ∩ W n) := by
  constructor
  · intro h n
    calc
      (F : Set Y) = closure ((F : Set Y) ∩ ⋂ k, W k) := h.symm
      _ ⊆ closure ((F : Set Y) ∩ W n) := closure_mono (inter_subset_inter_right _ (iInter_subset W n))
  · intro h
    let : PolishSpace F := F.isClosed.polishSpace
    have hd (n : ℕ) : Dense ((Subtype.val : F → Y) ⁻¹' W n) := by
      intro x
      rw [IsInducing.subtypeVal.closure_eq_preimage_closure_image]
      change x.val ∈ closure (Subtype.val '' ((Subtype.val : F → Y) ⁻¹' W n))
      rw [image_preimage_eq_inter_range, Subtype.range_coe, inter_comm]
      exact h n x.property
    have hdi := baire_category_dense_iInter (X := F)
      (G := fun n => (Subtype.val : F → Y) ⁻¹' W n)
      (fun n => (hW n).preimage continuous_subtype_val) hd
    apply subset_antisymm (closure_minimal inter_subset_left F.isClosed)
    intro x hx
    have hx' := hdi (⟨x, hx⟩ : F)
    rw [IsInducing.subtypeVal.closure_eq_preimage_closure_image] at hx'
    change x ∈ closure (Subtype.val '' (⋂ n, (Subtype.val : F → Y) ⁻¹' W n)) at hx'
    rw [← preimage_iInter, image_preimage_eq_inter_range, Subtype.range_coe, inter_comm] at hx'
    exact hx'

/-- The image criterion for a G-delta subspace is a countable conjunction of
implications between open hit sets. -/
theorem measurable_closure_inter_eq [PolishSpace Y] {S : Set Y} (hS : IsGδ S) :
    MeasurableSet {F : Closeds Y | closure ((F : Set Y) ∩ S) = F} := by
  obtain ⟨W, hW, rfl⟩ := hS.eq_iInter_nat
  obtain ⟨U, hU⟩ := exists_seq_basis Y
  have heq : {F : Closeds Y | closure ((F : Set Y) ∩ ⋂ n, W n) = F} =
      ⋂ n, ⋂ k, {F | F ∈ hit (U k) → F ∈ hit (U k ∩ W n)} := by
    ext F
    simp only [mem_ofPred_eq, mem_iInter, closure_inter_iInter_eq_iff F W hW,
      dense_inter_basis_iff F U hU]
  rw [heq]
  apply MeasurableSet.iInter
  intro n
  apply MeasurableSet.iInter
  intro k
  exact (measurable_hit (hU.isOpen (mem_range_self k))).imp
    (measurable_hit ((hU.isOpen (mem_range_self k)).inter (hW n)))

theorem measurable_range_ambientClosure [PolishSpace Y] (f : X → Y)
    (hf : IsEmbedding f) (hG : IsGδ (range f)) :
    MeasurableSet (range (ambientClosure f)) := by
  rw [range_ambientClosure f hf]
  exact measurable_closure_inter_eq hG

/-- On the range, taking the trace back to the source is measurable. Its open
hit preimages are ambient open hit sets restricted to the range. -/
theorem pullback_range_measurable (f : X → Y) (hf : IsEmbedding f) :
    Measurable (fun F : range (ambientClosure f) => pullback f hf.continuous F.val) := by
  apply measurable_iff_hit.mpr
  intro U hU
  obtain ⟨V, hV, hVU⟩ := hf.isInducing.isOpen_iff.mp hU
  have heq : (fun F : range (ambientClosure f) => pullback f hf.continuous F.val) ⁻¹' hit U =
      Subtype.val ⁻¹' hit V := by
    ext F
    obtain ⟨C, hC⟩ := F.property
    change pullback f hf.continuous F.val ∈ hit U ↔ F.val ∈ hit V
    rw [← hC, pullback_ambientClosure f hf, ambientClosure_hit_iff f C hV, hVU]
  rw [heq]
  exact (measurable_hit hV).preimage measurable_subtype_coe

/-@ booklink:
  source: polish-space-book/standard-borel-classification-closed-sets.md
  target: prose
  excerpt: |
    It remains to check that this identification has the Effros--Borel structure on both sides. If $U \IncludedIn \hat X$ is
    open, then
    $$\AmbientClosure{\hat X}{C}\cap U\ne\emptyset
    \quad\Longleftrightarrow\quad
    C\cap(U\cap X)\ne\emptyset,$$
    because $C$ is dense in its ambient closure. Thus $\Phi$ pulls every hit generator in $\ClosedSets{\hat X}$ back to a
    hit generator in $\ClosedSets{X}$. Conversely, on $\Phi(\ClosedSets{X})$, the inverse sends $\tilde C$ to
    $\tilde C\cap X$. If $O=U\cap X$ is open in $X$ with $U$ open in $\hat X$, then density of $\tilde C\cap X$ in
    $\tilde C$ gives
    $$
    (\tilde C\cap X)\cap O\ne\emptyset
    \quad\Longleftrightarrow\quad
    \tilde C\cap U\ne\emptyset.
    $$
    So the inverse also pulls Effros hit generators back to Effros hit generators. Hence $\ClosedSets{X}$ is
    Borel-isomorphic to the Borel subspace $\Phi(\ClosedSets{X}) \IncludedIn \ClosedSets{\hat X}$. By
    §{sec:polish-topology-refinement}, a Borel subset of a Polish space can be made clopen by a Borel-preserving Polish
    refinement, so this subspace is standard Borel. Therefore $\ClosedSets{X}$ is standard Borel.
    \end{proof}
-/
/-- Ambient closure and pullback give the book's actual measurable equivalence. -/
def ambientClosureEquiv (f : X → Y) (hf : IsEmbedding f) :
    Closeds X ≃ᵐ range (ambientClosure f) where
  toFun F := ⟨ambientClosure f F, mem_range_self F⟩
  invFun F := pullback f hf.continuous F.val
  left_inv := pullback_ambientClosure f hf
  right_inv F := by
    apply Subtype.ext
    obtain ⟨C, hC⟩ := F.property
    change ambientClosure f (pullback f hf.continuous F.val) = F.val
    rw [← hC, pullback_ambientClosure f hf]
  measurable_toFun := (ambientClosure_measurable f hf.continuous).subtype_mk
  measurable_invFun := pullback_range_measurable f hf

end EffrosBorel
end PolishSpaceBook
