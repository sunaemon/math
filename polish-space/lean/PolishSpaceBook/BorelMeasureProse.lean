module

public import PolishSpaceBook.BorelMeasuresPolishSpaces
public import PolishSpaceBook.ConditionalDistributions

@[expose] public section

/-! # Canonical measure definitions used in the chapter's prose

Keep the standard mathlib types and predicates. The regularity and tightness
bridges identify the chapter's explicit formulations with those interfaces.
-/

namespace PolishSpaceBook.BorelMeasureProse
open Set MeasureTheory ProbabilityTheory Filter Topology BoundedContinuousFunction
open scoped ENNReal MeasureTheory

/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    A \termdefine{Borel measure} on a Polish space $X$ is a measure on the Borel $\sigma$-algebra $\mathcal B(X)$. We focus
    on \termdefineas{finite Borel measure}{finite} Borel measures and especially
    \termdefineas{probability measure}{probability measures}: those with $\mu(X) = 1$. The space of all probability measures
    is denoted
    \begin{mathmeta}
      \define{ProbMeasures}
    \end{mathmeta}
    $$\ProbMeasures{X} := \{\mu : \mathcal B(X) \to [0, 1] : \mu \text{ a probability measure}\}.$$
-/
/-- The canonical probability-measure type has the stated Borel domain,
finite total mass, and normalization. -/
theorem probability_measure_spec {X : Type*} [TopologicalSpace X]
    [MeasurableSpace X] [BorelSpace X] (μ : ProbabilityMeasure X) :
    (inferInstance : MeasurableSpace X) = borel X ∧
    IsFiniteMeasure (μ : Measure X) ∧ (μ : Measure X) univ = 1 :=
  ⟨BorelSpace.measurable_eq, inferInstance, measure_univ⟩

/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    A measure that is inner regular by compacts and outer regular by opens is \termdefineas{Radon measure}{Radon}. Thus
    every finite Borel measure on a Polish space is Radon, and the descriptive and analytic notions of "well-behaved
    measure" coincide.
-/
/-- Compact inner approximants and open outer approximants for every Borel set. -/
theorem radon_approximation {X : Type*} [TopologicalSpace X] [PolishSpace X]
    [MeasurableSpace X] [BorelSpace X] (μ : Measure X) [IsFiniteMeasure μ] :
    μ.InnerRegularWRT (fun K => IsCompact K ∧ IsClosed K) MeasurableSet ∧
    ∀ A : Set X, MeasurableSet A → ∀ ε : ℝ≥0∞, 0 < ε →
      ∃ U : Set X, IsOpen U ∧ A ⊆ U ∧ μ (U \ A) < ε := by
  refine ⟨BorelMeasureRegularity.innerRegular_compact μ, ?_⟩
  intro A hA ε hε
  obtain ⟨F, U, _, hU, hFA, hAU, hsmall⟩ :=
    BorelMeasureRegularity.closed_open_approximation μ hA hε
  exact ⟨U, hU, hAU, (measure_mono (show U \ A ⊆ U \ F from
    fun _ hx => ⟨hx.1, fun hxF => hx.2 (hFA hxF)⟩)).trans_lt hsmall⟩

/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    The \termdefine{weak topology} on $\ProbMeasures{X}$ — also called the weak* topology — is generated by the maps $\mu
    \mapsto \int f \, d\mu$ for bounded continuous $f : X \to \R$.
-/
/-- The canonical weak topology is precisely convergence of all bounded
continuous test integrals. -/
theorem weak_topology_test_integrals {X : Type*} [TopologicalSpace X]
    [MeasurableSpace X] [OpensMeasurableSpace X]
    {I : Type*} {L : Filter I} {μs : I → ProbabilityMeasure X} {μ : ProbabilityMeasure X} :
    Tendsto μs L (𝓝 μ) ↔ ∀ f : X →ᵇ ℝ,
      Tendsto (fun i => ∫ x, f x ∂(μs i : Measure X)) L
        (𝓝 (∫ x, f x ∂(μ : Measure X))) :=
  ProbabilityMeasure.tendsto_iff_forall_integral_tendsto

/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    A family $\Gamma \IncludedIn \ProbMeasures{X}$ is \termdefineas{tight family of measures}{tight} if for every
    $\varepsilon
    >
    0$ there is a compact $K \IncludedIn X$ with $\mu(\SetDifference{X}{K}) < \varepsilon$ for every $\mu \in \Gamma$ —
    uniformly
    compactly concentrated, in the same sense \termuseas{Ulam theorem}{Ulam's theorem} gives for a single measure.
    
-/
/-- The chapter's strict-error compact concentration formulation is exactly
the canonical tightness predicate. -/
theorem tight_family_iff {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    (Γ : Set (ProbabilityMeasure X)) :
    IsTightMeasureSet {((μ : ProbabilityMeasure X) : Measure X) | μ ∈ Γ} ↔
      ∀ ε : ℝ≥0∞, 0 < ε → ∃ K : Set X, IsCompact K ∧
        ∀ μ ∈ Γ, (μ : Measure X) Kᶜ < ε := by
  rw [isTightMeasureSet_iff_exists_isCompact_measure_compl_le]
  constructor
  · intro h ε hε
    obtain ⟨δ, hδ0, hδε⟩ := exists_between hε
    obtain ⟨K, hK, hbound⟩ := h δ hδ0
    exact ⟨K, hK, fun μ hμ => (hbound μ ⟨μ, hμ, rfl⟩).trans_lt hδε⟩
  · intro h ε hε
    obtain ⟨K, hK, hbound⟩ := h ε hε
    refine ⟨K, hK, ?_⟩
    rintro ν ⟨μ, hμ, rfl⟩
    exact (hbound μ hμ).le

/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    A \termdefine{Markov kernel} from a standard Borel space $Y$ to a standard Borel space $X$ is a map
    $$K : Y \times \mathcal B(X) \to [0,1]$$
    such that:
-/
/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    1.  for each $y \in Y$, the set function $B \mapsto K(y,B)$ is a probability measure on $X$;
    2.  for each Borel $B \IncludedIn X$, the function $y \mapsto K(y,B)$ is Borel.
-/
/-- A Markov kernel is pointwise a probability measure and its Borel-set
evaluations are measurable, using the canonical kernel API. -/
theorem markov_kernel_spec {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (K : Kernel Y X) [IsMarkovKernel K] :
    (∀ y, IsProbabilityMeasure (K y)) ∧
      ∀ B : Set X, MeasurableSet B → Measurable (fun y => K y B) :=
  ⟨fun _ => inferInstance, fun _ hB => K.measurable_coe hB⟩

/-@ booklink:
  source: polish-space-book/borel-measures-polish-spaces.md
  target: prose
  excerpt: |
    More explicitly, let $(\Omega,\mathcal F,\mathbb P)$ be a probability space
    and let $\mathcal G\IncludedIn\mathcal F$ be a sub-$\sigma$-algebra. A
    \termdefineas{regular conditional probability}{regular conditional probability} $\mathbb P(\mathord\cdot\mid\mathcal G)$
    is a $\mathcal G$-measurable family $\omega\mapsto\mathbb P_\omega$ of probability measures such that
    $\omega\mapsto\mathbb P_\omega(A)$ is a version of $\mathbb E(1_A\mid\mathcal G)$ for every $A\in\mathcal F$.
-/
/-- A regular conditional probability is a Markov kernel measurable for the
conditioning sigma-algebra whose evaluations realize conditional expectations. -/
def IsRegularConditionalProbability {Ω : Type*} [m : MeasurableSpace Ω]
    (μ : Measure Ω) (G : MeasurableSpace Ω) (K : @Kernel Ω Ω G m) : Prop :=
  G ≤ m ∧ IsMarkovKernel K ∧ ∀ A : Set Ω, MeasurableSet A →
    (fun ω => (K ω).real A) =ᵐ[μ] μ[A.indicator (fun _ => (1 : ℝ)) | G]

end PolishSpaceBook.BorelMeasureProse
