module

public import PolishSpaceBook.JankovVonNeumannSelection

@[expose] public section

/-! # Jankov--von Neumann uniformization from least-index refinements

Closed witnesses are reassociated as closed sections in `Y × baire_space`.
Their open hit sets are analytic projections, so the explicit nested-limit
selector is measurable for the sigma-algebra generated by analytic sets.
-/
namespace PolishSpaceBook

noncomputable section
open Set TopologicalSpace Topology MeasureTheory

/-- The sigma-algebra generated by all analytic subsets of the given space. -/
abbrev analyticGenerated (X : Type*) [TopologicalSpace X] : MeasurableSpace X :=
  MeasurableSpace.generateFrom {A | AnalyticSet A}

/-- The whole construction, with the analytic-generated subspace sigma-algebra
on the projection explicitly specified in the conclusion. -/
/-@ booklink:
  source: polish-space-book/separation-uniformization-lusin-souslin.md
  target: statement
  kind: theorem
  title: Jankov--von Neumann uniformization
-/
/-@ booklink:
  source: polish-space-book/separation-uniformization-lusin-souslin.md
  target: proof
  excerpt: |
    \begin{proof}[Proof] Let $D:=\pi_X(A)$. By the
    \termuse{closed-projection characterization of analytic sets}, there is a closed set
    $$C\IncludedIn X\times Y\times\BaireSpace$$
    whose projection to $X\times Y$ is $A$. Put $Z:=Y\times\BaireSpace$, with any complete compatible metric.
    It is enough to choose, for each $x\in D$, a point $z=(y,p)\in Z$ such that $(x,z)\in C$; then $u(x):=y$ uniformizes
    $A$.
-/
/-@ booklink:
  source: polish-space-book/separation-uniformization-lusin-souslin.md
  target: proof
  excerpt: |
    It remains to check the promised measurability. Let
    $$
    E(O):=\{x\in X:C_x\cap O\ne\emptyset\},
    $$
    where $O\IncludedIn Z$ is open. Each $E(O)$ is analytic, because it is the projection to $X$ of the Borel set
    $C\cap(X\times O)$.
-/
theorem jankovVonNeumann_uniformization {X Y : Type*}
    [TopologicalSpace X] [PolishSpace X] [TopologicalSpace Y] [PolishSpace Y]
    {A : Set (X × Y)} (hA : AnalyticSet A) :
    ∃ u : (Prod.fst '' A) → Y, Uniformizes A u ∧
      @Measurable (Prod.fst '' A) Y
        (MeasurableSpace.comap Subtype.val (analyticGenerated X)) (borel Y) u := by
  classical
  obtain ⟨C₀, hC₀, hproj⟩ := (analyticSet_iff_closed_baire_projection A).mp hA
  let C : Set (X × (Y × baire_space)) := {t | ((t.1, t.2.1), t.2.2) ∈ C₀}
  have hC : IsClosed C := hC₀.preimage
    ((continuous_fst.prodMk (continuous_fst.comp continuous_snd)).prodMk
      (continuous_snd.comp continuous_snd))
  let D := Prod.fst '' A
  let F : D → Set (Y × baire_space) := fun x => {z | (x.val, z) ∈ C}
  have hclosed : ∀ x, IsClosed (F x) := fun x => hC.preimage (continuous_const.prodMk continuous_id)
  have hne : ∀ x, (F x).Nonempty := by
    intro x
    obtain ⟨⟨a, y⟩, hay, ha⟩ := x.property
    have hxy : (x.val, y) ∈ A := by simpa only [← ha] using hay
    obtain ⟨⟨xy, p⟩, hp, hxy'⟩ := hproj.symm ▸ hxy
    refine ⟨(y, p), ?_⟩
    change ((x.val, y), p) ∈ C₀
    simpa only [← hxy'] using hp
  let := upgradeIsCompletelyMetrizable (Y × baire_space)
  obtain ⟨W, hW⟩ := exists_seq_basis (Y × baire_space)
  let E : ℕ → Set X := fun i => Prod.fst '' (C ∩ Prod.snd ⁻¹' W i)
  have hE : ∀ i, AnalyticSet (E i) := by
    let : MeasurableSpace X := borel X
    let : BorelSpace X := ⟨rfl⟩
    let : MeasurableSpace (Y × baire_space) := borel (Y × baire_space)
    let : BorelSpace (Y × baire_space) := ⟨rfl⟩
    intro i
    exact analyticSet_borel_image_via_refinement
      (hC.measurableSet.inter ((hW.isOpen (mem_range_self i)).preimage continuous_snd).measurableSet)
      continuous_fst.measurable
  let : MeasurableSpace X := analyticGenerated X
  let : MeasurableSpace (Y × baire_space) := borel (Y × baire_space)
  let : BorelSpace (Y × baire_space) := ⟨rfl⟩
  have hhit : ∀ i, MeasurableSet {x : D | (F x ∩ W i).Nonempty} := by
    intro i
    have heq : {x : D | (F x ∩ W i).Nonempty} = Subtype.val ⁻¹' E i := by
      ext x
      constructor
      · rintro ⟨z, hzF, hzW⟩
        exact ⟨(x.val, z), ⟨hzF, hzW⟩, rfl⟩
      · rintro ⟨⟨a, z⟩, ⟨hzC, hzW⟩, ha⟩
        change a = x.val at ha
        exact ⟨z, by change (x.val, z) ∈ C; simpa only [ha] using hzC, hzW⟩
    rw [heq]
    exact (MeasurableSpace.measurableSet_generateFrom (hE i)).preimage measurable_subtype_coe
  let z := JankovVonNeumann.point F W hW hne
  have hz : Measurable z := JankovVonNeumann.point_measurable F W hW hne hhit
  let : MeasurableSpace Y := borel Y
  let : BorelSpace Y := ⟨rfl⟩
  refine ⟨fun x => (z x).1, ?_, continuous_fst.measurable.comp hz⟩
  intro x
  have hx := JankovVonNeumann.point_mem F W hW hne hclosed x
  apply hproj ▸ (show (x.val, (z x).1) ∈ Prod.fst '' C₀ from ?_)
  exact ⟨((x.val, (z x).1), (z x).2), hx, rfl⟩

end
end PolishSpaceBook
