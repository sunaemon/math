module

public import PolishSpaceBook.AnalyticSetsSuslinSchemes
public import Mathlib.Topology.Baire.BaireMeasurable

@[expose] public section

/-!
# Baire envelopes for analytic truth

The Silver argument needs local truth for coanalytic relations, beyond the
Borel-code recursion. This module constructs Baire envelopes in an arbitrary
second-countable topology. In particular, it does not assume that a topology
generated by relative analytic conditions is Polish, or that its analytic
sets are Borel. The envelopes are the category analogue of measurable hulls.
-/

namespace PolishSpaceBook
open Set Topology TopologicalSpace Filter

variable {X : Type*} [tX : TopologicalSpace X] [SecondCountableTopology X]

/-- The union of all open sets on which an arbitrary set is meager still
has meager intersection with that set. Second countability supplies the
countable subunion; no regularity assumption on the set is used. -/
theorem meagre_on_union_of_open (A : Set X) :
    IsMeagre (A ∩ ⋃₀ {U : Set X | IsOpen U ∧ IsMeagre (A ∩ U)}) := by
  let S := {U : Set X | IsOpen U ∧ IsMeagre (A ∩ U)}
  obtain ⟨T, hTc, hTS, hT⟩ := isOpen_sUnion_countable S (fun _ h => h.1)
  change IsMeagre (A ∩ ⋃₀ S)
  rw [← hT, sUnion_eq_biUnion, inter_iUnion]
  simp_rw [inter_iUnion]
  exact isMeagre_biUnion hTc (fun U hU => (hTS hU).2)

/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: statement
  kind: lemma
  title: Baire envelopes
-/
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    Let $U$ be the union of the open sets $V$ for which $A\cap V$ is meager. Second countability reduces this union to a
    countable subunion, so $A\cap U$ is meager. Put $B(A)=(\SetDifference{X}{U})\cup(A\cap U)$.
    This set contains $A$ and has the Baire property. If $C$ contains $A$ and has the Baire property, choose an open $V$
    agreeing with $\SetDifference{B(A)}{C}$ outside a meager set. Then $A\cap V$ is meager, since $A\IncludedIn C$, so
    $V\IncludedIn U$.
    But $B(A)\cap U\IncludedIn A\IncludedIn C$, hence $V\cap(\SetDifference{B(A)}{C})=\emptyset$. Their agreement outside
    the meager
    error set shows that $\SetDifference{B(A)}{C}$ is meager.
-/
/-- Every set has a Baire-measurable superset minimal modulo meager sets
among Baire-measurable supersets. This does not assert that the original
arbitrary set has the Baire property. -/
theorem exists_baire_envelope (A : Set X) :
    ∃ B : Set X, A ⊆ B ∧ BaireMeasurableSet B ∧
      ∀ C : Set X, BaireMeasurableSet C → A ⊆ C → IsMeagre (B \ C) := by
  let U := ⋃₀ {V : Set X | IsOpen V ∧ IsMeagre (A ∩ V)}
  have hU : IsOpen U := isOpen_sUnion (fun _ h => h.1)
  have hAU : IsMeagre (A ∩ U) := meagre_on_union_of_open A
  let B := Uᶜ ∪ (A ∩ U)
  have hAB : A ⊆ B := by
    intro x hx
    by_cases h : x ∈ U
    · exact Or.inr ⟨hx, h⟩
    · exact Or.inl h
  have hB : BaireMeasurableSet B := hU.baireMeasurableSet.compl.union hAU.baireMeasurableSet
  refine ⟨B, hAB, hB, ?_⟩
  intro C hC hAC
  obtain ⟨V, hV, hBV⟩ := (hB.diff hC).residualEq_isOpen
  have hAV : IsMeagre (A ∩ V) := by
    change ∀ᶠ x in residual X, x ∉ A ∩ V
    filter_upwards [hBV] with x hx h
    have hx' : x ∈ B \ C := hx.mpr h.2
    exact hx'.2 (hAC h.1)
  have hVU : V ⊆ U := subset_sUnion_of_mem ⟨hV, hAV⟩
  change ∀ᶠ x in residual X, x ∉ B \ C
  filter_upwards [hBV] with x hx h
  have hxV : x ∈ V := hx.mp h
  rcases h.1 with hnot | hA
  · exact hnot (hVU hxV)
  · exact h.2 (hAC hA.1)

/-- At every node a nonempty choice of successor yields a branch, without
any finite-branching assumption. -/
private theorem branch_of_successors (P : List ℕ → Prop) (hroot : P [])
    (hnext : ∀ s, P s → ∃ k, P (s ++ [k])) :
    ∃ p : ℕ → ℕ, ∀ n, P (seqPrefix p n) := by
  classical
  let next (s : {s : List ℕ // P s}) := (hnext s.val s.property).choose
  have hn (s : {s : List ℕ // P s}) : P (s.val ++ [next s]) :=
    (hnext s.val s.property).choose_spec
  let stage : ℕ → {s : List ℕ // P s} :=
    fun n => Nat.rec ⟨[], hroot⟩ (fun _ s => ⟨s.val ++ [next s], hn s⟩) n
  let p : ℕ → ℕ := fun n => next (stage n)
  have hp n : seqPrefix p n = (stage n).val := by
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [seqPrefix_succ_eq_concat, ih]
  exact ⟨p, fun n => hp n ▸ (stage n).property⟩

/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    For $s\in\finseq{\omega}$ put $S_s=\pi_0(K\cap(Z\times\cyl{s}))$, so $S_s=\bigcup_kS_{s\concat(k)}$.
    Choose Baire envelopes $B_s=B(S_s)$. Each of the sets
    $$\SetDifference{B_s}{\Closure{S_s}},\qquad \SetDifference{B_s}{\bigcup_k B_{s\concat(k)}}$$
    is meager by the envelope lemma. Remove their union over all $s$. Every remaining $z\in B_\emptyset$ admits a branch
    $p$ with $z\in B_{\restrict{p}{n}}\cap\Closure{S_{\restrict{p}{n}}}$ for every $n$. Every product neighborhood of
    $(z,p)$ then meets $K$: first fix a cylinder
    inside its second-coordinate neighborhood, then use $z\in\Closure{S_{\restrict{p}{n}}}$ in the first coordinate.
    Closedness gives $(z,p)\in K$. Thus $\SetDifference{B_\emptyset}{\pi_0(K)}$ is meager; the reverse difference is empty,
    so the
    projection has the Baire property.
-/
/-- Category hulls turn a tree of arbitrary sets into a Baire-measurable
root, provided the level bounds have the Baire property and branch limits
return to the root. All exceptional sets are a single countable union. -/
theorem baireMeasurable_of_tree_bounds (S F : List ℕ → Set X)
    (hbranch : ∀ s, S s = ⋃ k : ℕ, S (s ++ [k]))
    (hSF : ∀ s, S s ⊆ F s) (hF : ∀ s, BaireMeasurableSet (F s))
    (hlimit : ∀ (p : ℕ → ℕ) x, (∀ n, x ∈ F (seqPrefix p n)) → x ∈ S []) :
    BaireMeasurableSet (S []) := by
  classical
  choose B hSB hB hminimal using fun s => exists_baire_envelope (S s)
  let N : Set X := ⋃ s : List ℕ,
    (B s \ F s) ∪ (B s \ ⋃ k : ℕ, B (s ++ [k]))
  have hN : IsMeagre N := by
    apply isMeagre_iUnion
    intro s
    refine (hminimal s (F s) (hF s) (hSF s)).union ?_
    apply hminimal s _ (BaireMeasurableSet.iUnion (fun k => hB (s ++ [k])))
    rw [hbranch s]
    exact iUnion_mono (fun k => hSB (s ++ [k]))
  have hout (x : X) (hx : x ∉ N) (s : List ℕ) (hxs : x ∈ B s) :
      x ∈ F s ∧ ∃ k, x ∈ B (s ++ [k]) := by
    have he : x ∉ (B s \ F s) ∪ (B s \ ⋃ k : ℕ, B (s ++ [k])) :=
      fun h => hx (mem_iUnion.mpr ⟨s, h⟩)
    constructor
    · by_contra h
      exact he (Or.inl ⟨hxs, h⟩)
    · by_contra h
      exact he (Or.inr ⟨hxs, by simpa using h⟩)
  apply (hB []).congr
  filter_upwards [hN] with x hx
  apply propext
  constructor
  · intro hroot
    obtain ⟨p, hp⟩ := branch_of_successors (fun s => x ∈ B s) hroot
      (fun s hs => (hout x hx s hs).2)
    exact hlimit p x (fun n => (hout x hx _ (hp n)).1)
  · exact fun hxS => hSB [] hxS

/-- The projection with its witness constrained to one Baire cylinder. -/
def closedProjectionSlice (C : Set (X × baire_space)) (s : List ℕ) : Set X :=
  {x | ∃ p ∈ cyl s, (x, p) ∈ C}

omit [TopologicalSpace X] [SecondCountableTopology X] in
theorem closedProjectionSlice_children (C : Set (X × baire_space)) (s : List ℕ) :
    closedProjectionSlice C s = ⋃ k : ℕ, closedProjectionSlice C (s ++ [k]) := by
  ext x
  constructor
  · rintro ⟨p, hp, hC⟩
    refine mem_iUnion.mpr ⟨p s.length, p, ?_, hC⟩
    exact mem_cyl_concat_iff.mpr ⟨hp, by simp⟩
  · intro hx
    obtain ⟨k, p, hp, hC⟩ := mem_iUnion.mp hx
    exact ⟨p, cyl_concat_subset s [k] hp, hC⟩

omit [SecondCountableTopology X] in
/-- Closure at every witness prefix produces an actual witness in the
original closed set. This argument uses product neighborhoods and works
even when the topology of `X` is not metrizable or regular. -/
theorem mem_closed_of_projection_prefixes (C : Set (X × baire_space)) (hC : IsClosed C)
    (x : X) (p : baire_space)
    (hx : ∀ n, x ∈ closure (closedProjectionSlice C (seqPrefix p n))) : (x, p) ∈ C := by
  apply hC.closure_subset
  rw [mem_closure_iff]
  intro W hW hpW
  obtain ⟨U, V, hU, hV, hxU, hpV, hUV⟩ := isOpen_prod_iff.mp hW x p hpW
  obtain ⟨s, hps, hsV⟩ := exists_cyl_subset_of_mem_open hpV hV
  have heq : seqPrefix p s.length = s := seqPrefix_eq_of_mem_cyl hps
  obtain ⟨y, hyU, q, hqs, hyq⟩ := mem_closure_iff.mp (hx s.length) U hU hxU
  rw [heq] at hqs
  exact ⟨(y, q), hUV ⟨hyU, hsV hqs⟩, hyq⟩

/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: statement
  kind: lemma
  title: Baire property of closed projections
-/
/-- Projections of closed sets with Baire-space witnesses have the Baire
property in every second-countable space. No Polish refinement is assumed.
This is the regularity fact needed for coanalytic local truth in the
countable analytic-condition topology. -/
theorem baireMeasurableSet_closed_projection (C : Set (X × baire_space)) (hC : IsClosed C) :
    BaireMeasurableSet (Prod.fst '' C) := by
  have hroot : closedProjectionSlice C [] = Prod.fst '' C := by
    ext x
    constructor
    · rintro ⟨p, _, hp⟩
      exact ⟨(x, p), hp, rfl⟩
    · rintro ⟨⟨x, p⟩, hp, rfl⟩
      exact ⟨p, by simp [cyl_nil], hp⟩
  rw [← hroot]
  apply baireMeasurable_of_tree_bounds (closedProjectionSlice C)
    (fun s => closure (closedProjectionSlice C s))
    (closedProjectionSlice_children C) (fun _ => subset_closure)
    (fun _ => isClosed_closure.isOpen_compl.baireMeasurableSet.of_compl)
  intro p x hx
  exact ⟨p, by simp [cyl_nil], mem_closed_of_projection_prefixes C hC x p hx⟩

omit [SecondCountableTopology X] in
/-- Analytic sets have the Baire property, via a closed witness presentation
and the preceding category-envelope construction. -/
theorem analyticSet_baireMeasurableSet [PolishSpace X] (A : Set X)
    (hA : MeasureTheory.AnalyticSet A) : BaireMeasurableSet A := by
  obtain ⟨C, hC, rfl⟩ := (analyticSet_iff_closed_baire_projection A).mp hA
  exact baireMeasurableSet_closed_projection C hC

omit [SecondCountableTopology X] in
/-@ booklink:
  source: polish-space-book/effective-dst-gandy-harrington-dichotomies.md
  target: prose
  excerpt: |
    For the last assertion, take an ordinary closed witness presentation of the analytic set. The witness set remains
    closed when the topology of the first coordinate is refined. Apply the first assertion, and take complements for
    coanalytic sets. No claim that the refined topology is Polish is needed.
-/
/-- Analytic regularity persists in any second-countable finer topology.
Only the closed presentation is transported, so this does not assert
analyticity in the refined topology. -/
theorem analyticSet_baireMeasurableSet_finer [PolishSpace X] (A : Set X)
    (hA : MeasureTheory.AnalyticSet A) (t : TopologicalSpace X)
    (ht : t ≤ tX) [@SecondCountableTopology X t] :
    @BaireMeasurableSet X t A := by
  obtain ⟨C, hC, hCA⟩ := (@analyticSet_iff_closed_baire_projection X tX inferInstance A).mp hA
  have hid : @Continuous X X t tX id := continuous_id_of_le ht
  have hmap : @Continuous (X × baire_space) (X × baire_space)
      (@instTopologicalSpaceProd X baire_space t inferInstance)
      (@instTopologicalSpaceProd X baire_space tX inferInstance)
      (fun z => (id z.1, z.2)) :=
    @Continuous.prodMap X baire_space baire_space X tX inferInstance t inferInstance
      id id hid continuous_id
  have hCt : @IsClosed (X × baire_space)
      (@instTopologicalSpaceProd X baire_space t inferInstance) C :=
    @IsClosed.preimage (X × baire_space) (X × baire_space)
      (@instTopologicalSpaceProd X baire_space t inferInstance)
      (@instTopologicalSpaceProd X baire_space tX inferInstance) _ hmap C hC
  rw [← hCA]
  exact @baireMeasurableSet_closed_projection X t inferInstance C hCt

