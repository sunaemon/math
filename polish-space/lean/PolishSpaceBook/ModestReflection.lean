module

public import PolishSpaceBook.ModestAssemblies
public import Mathlib.CategoryTheory.Adjunction.Reflective

@[expose] public section

/-! # The reflection of assemblies into modest assemblies

Identify elements linked by shared realizers. A quotient class retains all names
of all its representatives. Descent to a modest target reuses the original tracker.
-/
namespace PolishSpaceBook.Assembly
open CategoryTheory
universe u v
variable {A : Type u} {K : PartialCombinatoryAlgebra A}

def sharesRealizer (X : Assembly.{u,v} K) (x y : X.Carrier) : Prop :=
  ∃ a, X.realizes a x ∧ X.realizes a y

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: proof
  excerpt: |
    For an assembly $X$, let $E$ be the equivalence relation on $|X|$ generated by
    $$x\mathrel{R}y\quad\Longleftrightarrow\quad
    \exists a\in A\,(a\Vdash_X x\land a\Vdash_X y).$$
    Set $Q:=\SetQuotient{|X|}{E}$ and give each class all the realizers of its representatives:
    $$a\Vdash_Q\EquivalenceClass{E}{x}\quad\Longleftrightarrow\quad
    \exists y\in|X|\,\bigl((y,x)\in E\land a\Vdash_X y\bigr).$$
    Every class has a realizer. If two classes share a realizer, some representatives share it, so they
    are related by $R$ and the classes coincide. Thus $Q$ is modest, and the quotient map $q:X\to Q$
    is tracked by the identity combinator.
-/
def modestReflection (X : Assembly.{u,v} K) : Assembly.{u,v} K where
  Carrier := Quot X.sharesRealizer
  realizes a z := ∃ x, Quot.mk X.sharesRealizer x = z ∧ X.realizes a x
  inhabited z := Quot.inductionOn z (fun x => by
    obtain ⟨a,ha⟩ := X.inhabited x
    exact ⟨a,x,rfl,ha⟩)

theorem modest_modestReflection (X : Assembly.{u,v} K) : Modest X.modestReflection := by
  rintro a _ _ ⟨x,rfl,hx⟩ ⟨y,rfl,hy⟩
  exact Quot.sound ⟨a,hx,hy⟩

def reflectionUnit (X : Assembly.{u,v} K) : X ⟶ X.modestReflection where
  toFun := Quot.mk X.sharesRealizer
  tracked := ⟨K.identity,fun x a ha => ⟨a,K.application_identity a,x,rfl,ha⟩⟩

theorem eq_of_sharesRealizer {X Y : Assembly.{u,v} K} (f : X ⟶ Y) (hy : Modest Y)
    {x y : X.Carrier} (h : X.sharesRealizer x y) : f x = f y := by
  obtain ⟨a,hx,hy'⟩ := h
  obtain ⟨r,hr⟩ := f.tracked
  obtain ⟨b,hb,hfx⟩ := hr x a hx
  obtain ⟨c,hc,hfy⟩ := hr y a hy'
  have e : b = c := Part.some_injective (hb.symm.trans hc)
  subst c
  exact hy b hfx hfy

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: proof
  excerpt: |
    Let $f:X\to Y$ have tracker $r$, with $Y$ modest. Whenever $x\mathrel{R}y$, a common input realizer
    $a$ gives a common output realizer $ra$ of $f(x),f(y)$, so $f(x)=f(y)$. Thus $f$ is constant on
    $E$-classes and induces a unique function $\overline f:Q\to Y$. The same $r$ tracks it: any realizer
    of a class realizes some representative, and its image realizes the common value of $f$ on that class.
    This gives $\overline f\circ q=f$, with uniqueness inherited from the quotient of sets. No computable
    choice of representatives is used.
-/
def reflectionDesc {X Y : Assembly.{u,v} K} (f : X ⟶ Y) (hy : Modest Y) :
    X.modestReflection ⟶ Y where
  toFun := Quot.lift f (fun _ _ h => eq_of_sharesRealizer f hy h)
  tracked := by
    obtain ⟨r,hr⟩ := f.tracked
    refine ⟨r,?_⟩
    rintro _ a ⟨x,rfl,hx⟩
    exact hr x a hx

@[simp] theorem reflectionUnit_desc {X Y : Assembly.{u,v} K} (f : X ⟶ Y) (hy : Modest Y) :
    reflectionUnit X ≫ reflectionDesc f hy = f := Hom.ext (fun _ => rfl)

theorem reflectionDesc_unique {X Y : Assembly.{u,v} K} (f : X ⟶ Y) (hy : Modest Y)
    (g : X.modestReflection ⟶ Y) (h : reflectionUnit X ≫ g = f) :
    g = reflectionDesc f hy := by
  apply Hom.ext
  intro z
  refine Quot.inductionOn z (fun x => ?_)
  exact congrArg (fun k : X ⟶ Y => k x) h

end Assembly

namespace ModestAssembly
open CategoryTheory
universe u v
variable {A : Type u} (K : PartialCombinatoryAlgebra A)

abbrev inclusion : ModestAssembly.{u,v} K ⥤ Assembly.{u,v} K :=
  ObjectProperty.ι Assembly.Modest

def reflectionFunctor : Assembly.{u,v} K ⥤ ModestAssembly.{u,v} K where
  obj X := ⟨X.modestReflection,X.modest_modestReflection⟩
  map f := ObjectProperty.homMk
    (Assembly.reflectionDesc (f ≫ Assembly.reflectionUnit _) (Assembly.modest_modestReflection _))
  map_id X := by
    apply ObjectProperty.hom_ext
    apply Assembly.Hom.ext
    intro z
    exact Quot.inductionOn z (fun _ => rfl)
  map_comp f g := by
    apply ObjectProperty.hom_ext
    apply Assembly.Hom.ext
    intro z
    exact Quot.inductionOn z (fun _ => rfl)

def reflectionHomEquiv (X : Assembly.{u,v} K) (Y : ModestAssembly.{u,v} K) :
    ((reflectionFunctor K).obj X ⟶ Y) ≃ (X ⟶ Y.obj) where
  toFun f := Assembly.reflectionUnit X ≫ f.hom
  invFun f := ObjectProperty.homMk (Assembly.reflectionDesc f Y.property)
  left_inv f := by
    apply ObjectProperty.hom_ext
    exact (Assembly.reflectionDesc_unique _ Y.property f.hom rfl).symm
  right_inv f := Assembly.reflectionUnit_desc f Y.property

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: proof
  excerpt: |
    For a morphism between assemblies, compose with the quotient map of its target and factor through
    the quotient of its source. Uniqueness of factorization gives the identity and composition laws,
    and precomposition with the quotient map gives the natural hom-set bijection for the adjunction.
-/
/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The category $\AsmCat{A}$ embeds fully and faithfully into the realizability topos $\RTCat{A}$ as the full subcategory
    of $\neg\neg$-separated objects. For each assembly, its canonical monomorphism into the constant object on its
    underlying set is $\neg\neg$-dense. Modest sets sit inside $\AsmCat{A}$ as a reflective subcategory, and hence
    embed into $\RTCat{A}$ as well. For $K_1$, modest sets correspond to the separated
    subquotients of the natural-numbers object; the larger class of discrete objects need not be separated. The
    next subsection records how $\RTCat{A}$ itself is
    built.
-/
def reflectionAdjunction : reflectionFunctor.{u,v} K ⊣ inclusion K :=
  Adjunction.mkOfHomEquiv {
    homEquiv := reflectionHomEquiv K
    homEquiv_naturality_left_symm := by
      intro X' X Y f g
      apply ObjectProperty.hom_ext
      apply Assembly.Hom.ext
      intro z
      exact Quot.inductionOn z (fun _ => rfl)
    homEquiv_naturality_right := by
      intro X Y Y' f g
      exact Assembly.Hom.ext (fun _ => rfl) }

/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  target: statement
  kind: proposition
  title: Modest reflection
-/
/-@ booklink:
  source: polish-space-book/appendix-category-theory-realizability.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The category $\AsmCat{A}$ embeds fully and faithfully into the realizability topos $\RTCat{A}$ as the full subcategory
    of $\neg\neg$-separated objects. For each assembly, its canonical monomorphism into the constant object on its
    underlying set is $\neg\neg$-dense. Modest sets sit inside $\AsmCat{A}$ as a reflective subcategory, and hence
    embed into $\RTCat{A}$ as well. For $K_1$, modest sets correspond to the separated
    subquotients of the natural-numbers object; the larger class of discrete objects need not be separated. The
    next subsection records how $\RTCat{A}$ itself is
    built.
-/
instance modestReflective : Reflective (inclusion.{u,v} K) where
  L := reflectionFunctor K
  adj := reflectionAdjunction K

end ModestAssembly
end PolishSpaceBook
