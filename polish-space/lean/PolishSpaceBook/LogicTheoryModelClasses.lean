module

public import PolishSpaceBook.InfinitaryLogic
public import PolishSpaceBook.AnalyticBorelMaps
public import PolishSpaceBook.EquivalenceRelationSeparation
public import Mathlib.ModelTheory.Encoding

@[expose] public section

set_option backward.isDefEq.respectTransparency false

noncomputable section
namespace PolishSpaceBook.LogicTheoryModelClasses
open Set Topology MeasureTheory FirstOrder FirstOrder.Language
open LogicActions
variable (L : FirstOrder.Language)

local instance : MeasurableSpace (ModelCode L) := borel _
local instance : BorelSpace (ModelCode L) := ⟨rfl⟩

lemma boundTerm_realize {n} (t : L.Term (Empty ⊕ Fin n))
    (M : ModelCode L) (a : Fin n → ℕ) :
    (t.relabel (Sum.elim Empty.elim id)).realize (M := ModelCarrier L M) a =
      t.realize (M := ModelCarrier L M) (Sum.elim Empty.elim a) := by
  rw [Term.realize_relabel]
  congr 1
  funext x
  cases x with
  | inl e => cases e
  | inr i => rfl

/-- Ordinary first-order syntax, interpreted in the actual relation/function
code. Quantification is a countable intersection over the fixed universe N. -/
/-@ booklink:
  source: polish-space-book/polish-groups.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The set $\mathrm{Mod}(T)$ is Borel because first-order satisfaction over the
    fixed universe $\NN$ is Borel,
-/
theorem measurableSet_firstOrder_satisfaction {n} (φ : L.BoundedFormula Empty n)
    (a : Fin n → ℕ) :
    MeasurableSet {M : ModelCode L |
      φ.Realize (M := ModelCarrier L M) Empty.elim a} := by
  induction φ with
  | falsum => exact MeasurableSet.empty
  | equal t s =>
    have h := (InfinitaryLogic.isClopen_equal
      (t.relabel (Sum.elim Empty.elim id))
      (s.relabel (Sum.elim Empty.elim id)) a).isClosed.measurableSet
    simpa only [InfinitaryLogic.Formula.Satisfies, InfinitaryLogic.Formula.Realize, BoundedFormula.Realize,
      boundTerm_realize] using h
  | rel r ts =>
    have h := (InfinitaryLogic.isClopen_rel r
      (fun i => (ts i).relabel (Sum.elim Empty.elim id)) a).isClosed.measurableSet
    simpa only [InfinitaryLogic.Formula.Satisfies, InfinitaryLogic.Formula.Realize, BoundedFormula.Realize,
      boundTerm_realize] using h
  | imp φ ψ ihφ ihψ =>
    convert (ihφ a).compl.union (ihψ a) using 1
    ext M
    simp only [BoundedFormula.Realize, mem_ofPred_eq, mem_union, mem_compl_iff,
      imp_iff_not_or]
  | all φ ih =>
    change MeasurableSet {M : ModelCode L |
      ∀ b : ℕ, φ.Realize (M := ModelCarrier L M) Empty.elim (Fin.snoc a b)}
    simpa only [Set.ofPred_forall] using MeasurableSet.iInter fun b => ih (Fin.snoc a b)

/-- The model set of a canonical first-order theory, with universe N. -/
def theoryModels (T : L.Theory) : Set (ModelCode L) :=
  {M | ∀ φ ∈ T, BoundedFormula.Realize (M := ModelCarrier L M) φ Empty.elim Fin.elim0}

/-- This is precisely the ordinary sentence-by-sentence model condition. -/
/-@ booklink:
  source: polish-space-book/polish-groups.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The set $\mathrm{Mod}(T)$ is Borel because first-order satisfaction over the
    fixed universe $\NN$ is Borel,
-/
theorem mem_theoryModels_iff (T : L.Theory) (M : ModelCode L) :
    M ∈ theoryModels L T ↔ ∀ φ ∈ T, ModelCarrier L M ⊨ φ := by
  simp only [theoryModels, mem_ofPred_eq, Sentence.Realize, FirstOrder.Language.Formula.Realize]
  rw [show (Empty.elim : Empty → ModelCarrier L M) = default from Subsingleton.elim _ _,
    show (Fin.elim0 : Fin 0 → ModelCarrier L M) = default from Subsingleton.elim _ _]

/-- The actual relabeling isomorphism preserves every sentence of the theory,
so the model class is invariant under the original logic action. -/
/-@ booklink:
  source: polish-space-book/polish-groups.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    but the orbit equivalence relation restricted to $\mathrm{Mod}(T)$ is still the analytic relation generated by the
    $\InfiniteSymmetricGroup$ action.
-/
theorem smul_mem_theoryModels_iff (T : L.Theory) (p : Equiv.Perm ℕ) (M : ModelCode L) :
    p • M ∈ theoryModels L T ↔ M ∈ theoryModels L T := by
  rw [mem_theoryModels_iff, mem_theoryModels_iff]
  exact forall_congr' fun φ => forall_congr' fun _ =>
    (StrongHomClass.realize_sentence (LogicActions.relabelIso L p M) φ).symm

/-- A countable language has countably many sentences, so the theory is a
countable intersection of the preceding Borel satisfaction sets. -/
/-@ booklink:
  source: polish-space-book/polish-groups.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    The set $\mathrm{Mod}(T)$ is Borel because first-order satisfaction over the
    fixed universe $\NN$ is Borel,
-/
theorem measurableSet_theoryModels
    [Countable (Σ n, L.Relations n)] [Countable (Σ n, L.Functions n)] (T : L.Theory) :
    MeasurableSet (theoryModels L T) := by
  have : Countable L.Symbols := inferInstance
  change MeasurableSet {M : ModelCode L | ∀ φ ∈ T,
    BoundedFormula.Realize (M := ModelCarrier L M) φ Empty.elim Fin.elim0}
  simpa only [Set.ofPred_forall] using
    MeasurableSet.iInter fun φ : L.Sentence =>
      MeasurableSet.iInter fun _ : φ ∈ T => measurableSet_firstOrder_satisfaction L φ Fin.elim0

/-- Restricting isomorphism to the Borel theory-model class retains an
analytic relation in the ambient product of the actual code spaces. -/
/-@ booklink:
  source: polish-space-book/polish-groups.md
  exclude-books: polish-space-ch1
  target: prose
  excerpt: |
    but the orbit equivalence relation restricted to $\mathrm{Mod}(T)$ is still the analytic relation generated by the
    $\InfiniteSymmetricGroup$ action.
-/
theorem analyticSet_theoryModelIso
    [Countable (Σ n, L.Relations n)] [Countable (Σ n, L.Functions n)] (T : L.Theory) :
    AnalyticSet {z : ModelCode L × ModelCode L |
      z.1 ∈ theoryModels L T ∧ z.2 ∈ theoryModels L T ∧
        Nonempty (ModelIso L z.1 z.2)} := by
  have hmodels : MeasurableSet {z : ModelCode L × ModelCode L |
      z.1 ∈ theoryModels L T ∧ z.2 ∈ theoryModels L T} :=
    ((measurableSet_theoryModels L T).preimage measurable_fst).inter
      ((measurableSet_theoryModels L T).preimage measurable_snd)
  have h := analyticSet_inter (analyticSet_of_borel_via_refinement hmodels)
    (LogicActions.analyticSet_modelIso L)
  convert h using 1
  ext z
  simp only [mem_inter_iff, mem_ofPred_eq]
  tauto

end PolishSpaceBook.LogicTheoryModelClasses
